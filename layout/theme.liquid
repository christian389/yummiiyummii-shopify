 <!-- Klaviyo Added to Cart Tracking -->
<script>
(function() {

  function trackAddToCart(addedItem) {
    try {
      if (!window.klaviyo) return;

      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          try {
            var items = cart.items.map(function(i) {
              return {
                'ProductID': i.product_id,
                'SKU': i.sku || '',
                'ProductName': i.product_title,
                'Quantity': i.quantity,
                'ItemPrice': i.price / 100,
                'RowTotal': (i.price * i.quantity) / 100,
                'ProductURL': window.location.origin + i.url,
                'ImageURL': i.image ? 'https:' + i.image : ''
              };
            });

            klaviyo.push(['track', 'Added to Cart', {
              '$value': cart.total_price / 100,

              // Flat properties — used by Klaviyo default templates
              'Product Name': addedItem.product_title,
              'Price': addedItem.price / 100,
              'Image URL': addedItem.image ? 'https:' + addedItem.image : '',
              'URL': window.location.origin + addedItem.url,

              // AddedItem properties — Klaviyo standard convention
              'AddedItemProductName': addedItem.product_title,
              'AddedItemProductID': addedItem.product_id,
              'AddedItemSKU': addedItem.sku || '',
              'AddedItemImageURL': addedItem.image ? 'https:' + addedItem.image : '',
              'AddedItemURL': window.location.origin + addedItem.url,
              'AddedItemPrice': addedItem.price / 100,
              'AddedItemQuantity': addedItem.quantity,

              'ItemNames': cart.items.map(function(i) { return i.product_title; }),
              'CheckoutURL': window.location.origin + '/checkout',
              'Items': items
            }]);
          } catch(e) {}
        })
        .catch(function() {});
    } catch(e) {}
  }

  var originalFetch = window.fetch;
  window.fetch = function() {
    var args = arguments;
    var url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
    if (url.indexOf('/cart/add') !== -1) {
      return originalFetch.apply(this, args).then(function(response) {
        var clone = response.clone();
        clone.json().then(function(data) {
          try {
            var items = data.items || [data];
            items.forEach(function(item) { trackAddToCart(item); });
          } catch(e) {}
        });
        return response;
      });
    }
    return originalFetch.apply(this, args);
  };

  var origOpen = XMLHttpRequest.prototype.open;
  var origSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function(method, url) {
    this._klaviyoUrl = url;
    return origOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function(body) {
    var xhr = this;
    if (xhr._klaviyoUrl && xhr._klaviyoUrl.indexOf('/cart/add') !== -1) {
      xhr.addEventListener('load', function() {
        try {
          var data = JSON.parse(xhr.responseText);
          var items = data.items || [data];
          items.forEach(function(item) { trackAddToCart(item); });
        } catch(e) {}
      });
    }
    return origSend.apply(this, arguments);
  };

})();
</script>

