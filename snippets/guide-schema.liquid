{% comment %}
  Renders FAQPage JSON-LD for a Guide article.

  Article + BreadcrumbList structured data already emit automatically for
  every article page via snippets/microdata-schema.liquid ({{ article |
  structured_data }} + a hand-built BreadcrumbList) -- this snippet only
  covers FAQPage, which Shopify's native structured_data filter does not
  produce. Renders nothing if the guide has no FAQ items, so it never
  outputs an empty/invalid FAQPage block.

  Assumes article.metafields.guide.faq_items is a metaobject list with
  "question" and "answer" fields (Guide FAQ Item definition). Field values
  are read directly off each entry (item.question.value), not via a
  `.fields.` accessor -- see the note in sections/guide-comparison-table.liquid.

  Usage:
  {% render 'guide-schema' %}
{% endcomment %}

{%- liquid
  assign faq_items = article.metafields.guide.faq_items.value
-%}

{%- if faq_items and faq_items.size > 0 -%}
  {%- liquid
    assign rendered_count = 0
  -%}
  {%- capture faq_json -%}
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq_items -%}
          {%- liquid
            assign question = item.question.value
            assign answer = item.answer.value | strip_html | strip_newlines
          -%}
          {%- if question != blank and answer != blank -%}
            {%- if rendered_count > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ question | strip_html | strip_newlines | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ answer | json }}
              }
            }
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  {%- endcapture -%}
  {%- if rendered_count > 0 -%}
    <script type="application/ld+json">{{ faq_json }}</script>
  {%- endif -%}
{%- endif -%}
