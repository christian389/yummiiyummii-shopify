{% comment %}
  Yummii Yummii — Hero-banner (genbrugelig)
  Bruges på kollektionssider (henter collection.title/description/image automatisk)
  eller hvor som helst via egne indstillinger. Fuld-bleed billede + gradient + brødkrumme.
{% endcomment %}

{%- assign h_title = section.settings.heading | default: collection.title -%}
{%- assign h_sub = section.settings.subtitle -%}
{%- if h_sub == blank -%}{%- assign h_sub = collection.description | strip_html | truncatewords: 40 -%}{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .yyhero{ position:relative; display:flex; align-items:{{ section.settings.valign | default: 'flex-end' }}; min-height:{{ section.settings.height | default: 420 }}px; overflow:hidden;
    background:{% if section.settings.image %}url('{{ section.settings.image | image_url: width: 2200 }}'){% elsif collection.image %}url('{{ collection.image | image_url: width: 2200 }}'){% else %}{{ section.settings.fallback_color | default: '#3d7a4f' }}{% endif %} center {{ section.settings.focus | default: 40 }}%/cover no-repeat; }
  #shopify-section-{{ section.id }} .yyhero::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(20,28,18,{{ section.settings.overlay_top | default: 0.5 }}), rgba(20,28,18,.12) 42%, rgba(20,28,18,{{ section.settings.overlay_bottom | default: 0.66 }})); }
  #shopify-section-{{ section.id }} .yyhero__in{ position:relative; z-index:2; width:100%; max-width:1320px; margin:0 auto; padding:{{ section.settings.pad_top | default: 60 }}px 30px {{ section.settings.pad_bottom | default: 48 }}px; color:#fff; text-align:{{ section.settings.text_align | default: 'left' }}; }
  #shopify-section-{{ section.id }} .yyhero__crumb{ font-size:12.5px; letter-spacing:.04em; opacity:.9; display:flex; align-items:center; gap:9px; margin-bottom:18px; justify-content:{% if section.settings.text_align == 'center' %}center{% else %}flex-start{% endif %}; }
  #shopify-section-{{ section.id }} .yyhero__crumb a{ opacity:.85; } #shopify-section-{{ section.id }} .yyhero__crumb a:hover{ opacity:1; }
  #shopify-section-{{ section.id }} .yyhero__crumb .sep{ opacity:.5; } #shopify-section-{{ section.id }} .yyhero__crumb .cur{ font-weight:600; }
  #shopify-section-{{ section.id }} .yyhero__eyebrow{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; font-weight:700; color:{{ section.settings.accent | default: '#ffd66b' }}; margin:0 0 12px; }
  #shopify-section-{{ section.id }} .yyhero h1{ font-family:'DM Sans',system-ui,sans-serif; font-size:clamp(30px,5vw,54px); font-weight:600; letter-spacing:-.025em; line-height:1.03; text-shadow:0 2px 30px rgba(0,0,0,.28); margin:0; }
  #shopify-section-{{ section.id }} .yyhero__sub{ font-family:'DM Sans',system-ui,sans-serif; margin:14px 0 0; font-size:clamp(14.5px,1.4vw,18px); line-height:1.55; max-width:56ch; opacity:.95; {% if section.settings.text_align == 'center' %}margin-left:auto; margin-right:auto;{% endif %} }
  #shopify-section-{{ section.id }} .yyhero__cta{ display:inline-flex; align-items:center; gap:9px; margin-top:22px; background:{{ section.settings.accent | default: '#ffd66b' }}; color:#243f2c; border-radius:999px; padding:14px 26px; font-family:'DM Sans',system-ui,sans-serif; font-size:15px; font-weight:600; text-decoration:none; transition:.16s; }
  #shopify-section-{{ section.id }} .yyhero__cta:hover{ transform:translateY(-1px); }
  #shopify-section-{{ section.id }} .yyhero__count{ margin-top:16px; display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:600; background:rgba(255,255,255,.16); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); border:1px solid rgba(255,255,255,.28); padding:8px 15px; border-radius:999px; color:#fff; }
  /* Avatar-ikoner (folkene bag) */
  #shopify-section-{{ section.id }} .yyhero__avatars{ display:flex; align-items:center; gap:16px; margin-top:20px; flex-wrap:wrap; justify-content:{% if section.settings.text_align == 'center' %}center{% else %}flex-start{% endif %}; }
  #shopify-section-{{ section.id }} .yyhero__avlabel{ font-family:'DM Sans',system-ui,sans-serif; font-size:13px; font-weight:600; opacity:.9; max-width:16ch; line-height:1.3; text-align:left; color:#fff; }
  #shopify-section-{{ section.id }} .yyhero__avrow{ display:flex; {% if section.settings.avatars_overlap %}padding:2px 0;{% else %}gap:{{ section.settings.avatars_gap | default: 16 }}px;{% endif %} }
  #shopify-section-{{ section.id }} .yyhero__av{ margin:0; text-align:center; position:relative; }
  {%- if section.settings.avatars_overlap -%}
  #shopify-section-{{ section.id }} .yyhero__av + .yyhero__av{ margin-left:-{{ section.settings.avatars_size | default: 40 | times: 0.34 | round }}px; }
  #shopify-section-{{ section.id }} .yyhero__av:nth-child(1){ z-index:6; } #shopify-section-{{ section.id }} .yyhero__av:nth-child(2){ z-index:5; } #shopify-section-{{ section.id }} .yyhero__av:nth-child(3){ z-index:4; } #shopify-section-{{ section.id }} .yyhero__av:nth-child(4){ z-index:3; } #shopify-section-{{ section.id }} .yyhero__av:nth-child(5){ z-index:2; }
  #shopify-section-{{ section.id }} .yyhero__avatars figcaption{ display:none; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .yyhero__avimg{ display:block; width:{{ section.settings.avatars_size | default: 40 }}px; height:{{ section.settings.avatars_size | default: 40 }}px; border-radius:50%; overflow:hidden; background:rgba(255,255,255,.18); box-shadow:0 0 0 3px rgba(255,255,255,.92), 0 3px 10px rgba(0,0,0,.28); }
  #shopify-section-{{ section.id }} .yyhero__av a{ display:block; }
  #shopify-section-{{ section.id }} .yyhero__avimg img{ width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .yyhero__avimg.is-ph{ display:flex; align-items:center; justify-content:center; color:#fff; }
  #shopify-section-{{ section.id }} .yyhero__avimg.is-ph svg{ width:46%; height:46%; opacity:.7; }
  #shopify-section-{{ section.id }} .yyhero__av figcaption{ font-family:'DM Sans',system-ui,sans-serif; font-size:11.5px; font-weight:600; margin-top:6px; opacity:.92; white-space:nowrap; color:#fff; }
  @media(max-width:560px){
    #shopify-section-{{ section.id }} .yyhero__in{ padding-left:16px; padding-right:16px; }
    #shopify-section-{{ section.id }} .yyhero__avlabel{ text-align:center; max-width:none; flex-basis:100%; }
  }
{% endstyle %}

<section class="yyhero">
  <div class="yyhero__in">
    {%- if section.settings.show_breadcrumb -%}
      <div class="yyhero__crumb">
        <a href="{{ routes.root_url }}">Forside</a><span class="sep">/</span><span class="cur">{{ h_title }}</span>
      </div>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="yyhero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if h_title != blank -%}<h1>{{ h_title }}</h1>{%- endif -%}
    {%- if h_sub != blank -%}<p class="yyhero__sub">{{ h_sub }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="yyhero__avatars">
        {%- if section.settings.avatars_label != blank -%}<span class="yyhero__avlabel">{{ section.settings.avatars_label }}</span>{%- endif -%}
        <div class="yyhero__avrow">
          {%- for block in section.blocks -%}{%- if block.type == 'avatar' -%}
            <figure class="yyhero__av" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              <span class="yyhero__avimg{% if block.settings.image == blank %} is-ph{% endif %}">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.name | escape }}" width="60" height="60" loading="lazy">{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>{%- endif -%}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
              {%- if block.settings.name != blank -%}<figcaption>{{ block.settings.name }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    {%- if section.settings.show_count and collection != blank -%}
      <div><span class="yyhero__count">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 12h18"/></svg>
        {{ collection.products_count }} produkter
      </span></div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div><a class="yyhero__cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YY — Hero",
  "settings": [
    { "type": "paragraph", "content": "På en kollektionsside udfyldes titel, tekst og billede automatisk fra kollektionen. Felterne nedenfor kan overstyre." },
    { "type": "text", "id": "eyebrow", "label": "Overtekst (valgfri)" },
    { "type": "text", "id": "heading", "label": "Overskrift (overstyr)" },
    { "type": "textarea", "id": "subtitle", "label": "Undertekst (overstyr)" },
    { "type": "image_picker", "id": "image", "label": "Baggrundsbillede (overstyr)" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Vis brødkrumme", "default": true },
    { "type": "checkbox", "id": "show_count", "label": "Vis produkt-antal (kun kollektion)", "default": true },
    { "type": "header", "content": "Avatar-ikoner (folkene bag)" },
    { "type": "paragraph", "content": "Tilføj ‘Avatar’-blokke nedenfor — små runde billeder under overskrifterne." },
    { "type": "text", "id": "avatars_label", "label": "Label ved siden af (valgfri)", "info": "Fx ‘Værterne bag liven’. Tom = kun billeder." },
    { "type": "checkbox", "id": "avatars_overlap", "label": "Lad billederne overlappe (stak)", "default": true, "info": "Til: klassisk overlappende vært-stak (navne skjules). Fra: adskilte med afstand + navne." },
    { "type": "range", "id": "avatars_size", "label": "Størrelse", "min": 32, "max": 88, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "avatars_gap", "label": "Afstand mellem (kun uden overlap)", "min": 6, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "CTA (valgfri)" },
    { "type": "text", "id": "cta_label", "label": "Knap-tekst" },
    { "type": "url", "id": "cta_link", "label": "Knap-link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height", "min": 240, "max": 720, "step": 20, "unit": "px", "label": "Højde", "default": 420 },
    { "type": "range", "id": "focus", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Billede-fokus (lodret)", "default": 40 },
    { "type": "select", "id": "valign", "label": "Lodret placering", "options": [ { "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Midt" }, { "value": "flex-end", "label": "Bund" } ], "default": "flex-end" },
    { "type": "select", "id": "text_align", "label": "Tekstjustering", "options": [ { "value": "left", "label": "Venstre" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "range", "id": "pad_bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding bund", "default": 48 },
    { "type": "range", "id": "pad_top", "min": 20, "max": 200, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "header", "content": "Farver" },
    { "type": "color", "id": "accent", "label": "Accent (overtekst/CTA)", "default": "#ffd66b" },
    { "type": "color", "id": "fallback_color", "label": "Fallback-baggrund", "default": "#3d7a4f" },
    { "type": "range", "id": "overlay_top", "min": 0, "max": 1, "step": 0.1, "label": "Overlay top", "default": 0.5 },
    { "type": "range", "id": "overlay_bottom", "min": 0, "max": 1, "step": 0.1, "label": "Overlay bund", "default": 0.7 }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Avatar",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "name", "label": "Navn (valgfrit)" },
        { "type": "url", "id": "link", "label": "Link (valgfrit)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YY — Hero",
      "blocks": [ { "type": "avatar" }, { "type": "avatar" }, { "type": "avatar" } ]
    }
  ]
}
{% endschema %}
