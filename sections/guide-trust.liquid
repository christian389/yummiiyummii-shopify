{% comment %}
  Guide -- Trust & sender / E-E-A-T badges (playbook section 8).
  Not metaobject-driven -- no article metafield backs this, since the
  credibility badges are brand-standard rather than per-guide facts. Normal
  repeatable section blocks, preset with the 4 reference badges.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}

  <div class="guide">
    <div
      class="guide-trust"
      id="tillid"
      data-guide-toc-label="{{ section.settings.heading | escape }}"
    >
      <div class="guide-trust__inner">
        <h2 class="guide-heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="guide-intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}

        <div class="guide-trust__grid">
          {%- for block in section.blocks -%}
            <div class="guide-trust__badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="guide-trust__icon">
                  {%- assign badge_alt = block.settings.title | escape -%}
                  {{ block.settings.icon | image_url: width: 64 | image_tag: width: 32, height: 32, alt: badge_alt, loading: 'lazy' }}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <div class="guide-trust__title">{{ block.settings.title | escape }}</div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <div class="guide-trust__caption">{{ block.settings.caption | escape }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.trust.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:guide.trust.settings.heading.label",
      "default": "Derfor kan du stole på det"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:guide.trust.settings.intro.label"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:guide.trust.blocks.badge.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:guide.trust.blocks.badge.settings.icon.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:guide.trust.blocks.badge.settings.title.label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:guide.trust.blocks.badge.settings.caption.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:guide.trust.name",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "Fødevaregodkendt i EU",
            "caption": "Testet efter EU-forordning 1935/2004."
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Fri for BPA og ftalater",
            "caption": "Ingen mikroplastik i kontakt med maden."
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "10 års garanti på stål",
            "caption": "Gælder materiale- og fabrikationsfejl."
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "4,5 på Trustpilot",
            "caption": "Baseret på over 1.200 anmeldelser."
          }
        }
      ]
    }
  ]
}
{% endschema %}
