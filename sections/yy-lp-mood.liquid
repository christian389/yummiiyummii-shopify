{% comment %}Yummii Yummii — Landingsside: Stemningsbilleder (grid){% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section class="yy-lp-section">
    <div class="yy-lp-wrap">
      {%- if section.settings.heading != blank -%}<h2 class="yy-lp-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="yy-lp-intro">{{ section.settings.intro }}</p>{%- endif -%}

      <div class="yy-lp-mood-grid">
        {%- for block in section.blocks -%}
          <div class="yy-lp-mood {% if block.settings.layout == 'tall' %}yy-lp-mood--tall{% elsif block.settings.layout == 'wide' %}yy-lp-mood--wide{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {%- assign mood_h = 800 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" width="800" height="{{ mood_h }}" loading="lazy">
            {%- else -%}
              {{ block.settings.placeholder_text | default: 'Stemningsbillede' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP — Stemningsbilleder",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [ { "value": "paper", "label": "Papir" }, { "value": "white", "label": "Hvid" }, { "value": "cream", "label": "Cremefarvet" } ],
      "default": "paper"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Lavet til den virkelige hverdag" },
    { "type": "textarea", "id": "intro", "label": "Introtekst", "default": "Stemningsbilleder fra køkkenbordet, madpakken og turen ud af døren." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Billede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "placeholder_text", "label": "Placeholder-tekst (vises uden billede)" },
        {
          "type": "select",
          "id": "layout",
          "label": "Størrelse",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "tall", "label": "Høj (2 rækker)" },
            { "value": "wide", "label": "Bred (2 kolonner)" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Stemningsbilleder",
      "blocks": [
        { "type": "photo", "settings": { "layout": "tall", "placeholder_text": "Madpakke pakkes" } },
        { "type": "photo", "settings": { "layout": "wide", "placeholder_text": "Madkasse fyldt med farverig mad" } },
        { "type": "photo", "settings": { "placeholder_text": "Barn med madkasse" } },
        { "type": "photo", "settings": { "placeholder_text": "Stål-detalje" } },
        { "type": "photo", "settings": { "layout": "wide", "placeholder_text": "Familie ved køkkenbord" } },
        { "type": "photo", "settings": { "placeholder_text": "Snackboks med frugt" } }
      ]
    }
  ]
}
{% endschema %}
