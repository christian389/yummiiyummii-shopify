{% comment %}
  Guide -- Comparison table (playbook section 4).

  Reads article.metafields.guide.comparison_options (metaobject list,
  "Guide Comparison Option" -- one entry per column) and
  article.metafields.guide.comparison_caveat (single line text).
  Renders nothing if no options are set.

  Field handles (name, material, best_for, temp_retention, dishwasher_safe,
  oven_microwave, leak_proof, chemical_free, warranty, collection_url)
  confirmed against the live "Guide Comparison Option" metaobject
  definition. Row order/labels are driven by a known-field map (Danish
  labels) with a humanized fallback for any unrecognized field key, so the
  table still degrades gracefully if a handle changes later.

  Per Shopify's Liquid metaobject reference
  (https://shopify.dev/docs/api/liquid/objects/metaobject), a metaobject
  entry's field values are read directly off the entry by field key --
  `option.<key>.value`, or `option[<key>].value` for a dynamic key -- not
  through a `.fields.<key>` accessor. `.fields` (an array of field objects)
  is a GraphQL Admin/Storefront API shape, not a documented Liquid property,
  so `option.fields.x.value` / `option.fields[x].value` silently resolve to
  nothing instead of erroring.
{% endcomment %}

{%- liquid
  assign options = article.metafields.guide.comparison_options.value
  assign caveat = article.metafields.guide.comparison_caveat.value
  assign known_row_keys = 'material,best_for,temp_retention,dishwasher_safe,oven_microwave,leak_proof,chemical_free,warranty' | split: ','
-%}

{%- if options and options.size > 0 -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}

  <div class="guide">
    <div
      class="guide-section"
      id="sammenligning"
      data-guide-toc-label="{{ section.settings.heading | escape }}"
    >
      <h2 class="guide-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="guide-intro">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="guide-table-wrap">
        <table class="guide-table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.criteria_label | escape }}</th>
              {%- for option in options -%}
                <th scope="col">{{ option.name.value | escape }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row_key in known_row_keys -%}
              {%- liquid
                assign row_has_data = false
                for option in options
                  assign row_value = option[row_key].value
                  if row_value != blank
                    assign row_has_data = true
                  endif
                endfor
              -%}

              {%- if row_has_data -%}
                {%- case row_key -%}
                  {%- when 'material' -%}
                    {%- assign row_label = 'Materiale' -%}
                  {%- when 'best_for' -%}
                    {%- assign row_label = 'Bedst til' -%}
                  {%- when 'temp_retention' -%}
                    {%- assign row_label = 'Holder temperatur' -%}
                  {%- when 'dishwasher_safe' -%}
                    {%- assign row_label = 'Opvaskemaskine' -%}
                  {%- when 'oven_microwave' -%}
                    {%- assign row_label = 'Ovn og mikroovn' -%}
                  {%- when 'leak_proof' -%}
                    {%- assign row_label = 'Lækagesikker' -%}
                  {%- when 'chemical_free' -%}
                    {%- assign row_label = 'Kemifri' -%}
                  {%- when 'warranty' -%}
                    {%- assign row_label = 'Garanti' -%}
                  {%- else -%}
                    {%- assign row_label = row_key | replace: '_', ' ' | capitalize -%}
                {%- endcase -%}

                <tr>
                  <th scope="row">{{ row_label }}</th>
                  {%- for option in options -%}
                    <td>{{ option[row_key].value }}</td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}

            {%- liquid
              assign any_link = false
              for option in options
                if option.collection_url.value != blank
                  assign any_link = true
                endif
              endfor
            -%}
            {%- if any_link -%}
              <tr>
                <th scope="row">{{ section.settings.link_row_label | escape }}</th>
                {%- for option in options -%}
                  <td>
                    {%- if option.collection_url.value != blank -%}
                      <a href="{{ option.collection_url.value }}">{{ section.settings.link_row_label | escape }}</a>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
          </tbody>
        </table>
      </div>

      {%- if caveat != blank -%}
        <p class="guide-table__caveat">{{ caveat | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.comparison_table.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:guide.comparison_table.settings.heading.label",
      "default": "Sammenligning"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:guide.comparison_table.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "criteria_label",
      "label": "t:guide.comparison_table.settings.criteria_label.label",
      "default": "Kriterium"
    },
    {
      "type": "text",
      "id": "link_row_label",
      "label": "t:guide.comparison_table.settings.link_row_label.label",
      "default": "Se sortimentet"
    }
  ],
  "presets": [
    {
      "name": "t:guide.comparison_table.name"
    }
  ]
}
{% endschema %}
