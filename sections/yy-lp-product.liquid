{% comment %}Yummii Yummii — Landingsside: Produkt / PDP (galleri + sæt-card){% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yy-landing.js' | asset_url }}" defer></script>

{%- liquid
  assign bundle_product = section.settings.bundle_product
  assign current_variant = nil
  assign bundle_cents = 0
  assign has_bundle = false
  if bundle_product != blank
    assign current_variant = bundle_product.selected_or_first_available_variant
    assign bundle_cents = current_variant.price
    assign has_bundle = true
  endif

  assign individual_total = 0
  for block in section.blocks
    if block.type == 'set_row' and block.settings.product != blank
      assign row_v = block.settings.product.selected_or_first_available_variant
      assign individual_total = individual_total | plus: row_v.price
    endif
  endfor

  assign savings_cents = 0
  assign savings_pct = 0
  if has_bundle and individual_total > bundle_cents and bundle_cents > 0
    assign savings_cents = individual_total | minus: bundle_cents
    assign savings_pct = savings_cents | times: 100 | divided_by: individual_total | round
  endif
-%}

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section id="kob" class="yy-lp-section">
    <div class="yy-lp-wrap">
      <div class="yy-lp-pdp">

        <!-- GALLERI -->
        <div class="yy-lp-gallery" data-yylp-gallery>
          <div class="yy-lp-main" data-yylp-main></div>
          <div class="yy-lp-thumbs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'gallery_video' -%}
                {%- assign vurl = '' -%}
                {%- if block.settings.video != blank -%}
                  {%- assign vmp4 = block.settings.video.sources | where: 'format', 'mp4' | last -%}
                  {%- if vmp4 -%}{%- assign vurl = vmp4.url -%}{%- endif -%}
                {%- endif -%}
                <button
                  class="yy-lp-thumb {% if forloop.first %}is-active{% endif %}"
                  data-yylp-thumb
                  data-media-type="video"
                  data-media-src="{{ vurl }}"
                  aria-label="{{ block.settings.label | default: 'Video' }}"
                  {{ block.shopify_attributes }}>
                  <span class="yy-lp-tvid"></span>
                </button>
              {%- elsif block.type == 'gallery_image' -%}
                <button
                  class="yy-lp-thumb {% if forloop.first %}is-active{% endif %}"
                  data-yylp-thumb
                  data-media-type="image"
                  data-media-src="{{ block.settings.image | image_url: width: 1200 }}"
                  data-media-alt="{{ block.settings.image.alt | escape }}"
                  aria-label="{{ block.settings.label | default: block.settings.image.alt | escape }}"
                  {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- assign thumb_h = 160 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
                    <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.image.alt | escape }}" width="160" height="{{ thumb_h }}" loading="lazy">
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- INFO -->
        <div class="yy-lp-info">
          {%- if section.settings.eyebrow != blank -%}<p class="yy-lp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="yy-lp-info-title">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.lede != blank -%}<p class="yy-lp-lede">{{ section.settings.lede }}</p>{%- endif -%}

          <div class="yy-lp-setcard">
            {%- for block in section.blocks -%}
              {%- if block.type == 'set_row' and block.settings.product != blank -%}
                {%- assign p = block.settings.product -%}
                {%- assign pv = p.selected_or_first_available_variant -%}
                <div class="yy-lp-setrow" {{ block.shopify_attributes }}>
                  {%- if p.featured_image != blank -%}
                    {%- assign row_h = 124 | times: p.featured_image.height | divided_by: p.featured_image.width -%}
                    <img src="{{ p.featured_image | image_url: width: 124 }}" alt="{{ p.title | escape }}" width="124" height="{{ row_h }}" loading="lazy">
                  {%- endif -%}
                  <div class="yy-lp-nm">
                    {{ block.settings.title_override | default: p.title }}
                    {%- if block.settings.subtitle != blank -%}<small>{{ block.settings.subtitle }}</small>{%- endif -%}
                  </div>
                  <div class="yy-lp-pr">{{ pv.price | money_without_trailing_zeros }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            <div class="yy-lp-setdiv"></div>

            {%- if individual_total > 0 -%}
              <div class="yy-lp-setsum">
                <span class="yy-lp-l">{{ section.settings.label_compare | default: 'Købt separat' }}</span>
                <span class="yy-lp-was">{{ individual_total | money_without_trailing_zeros }}</span>
              </div>
            {%- endif -%}

            <div class="yy-lp-setsum yy-lp-setsum--total">
              <span class="yy-lp-l">{{ section.settings.label_bundle | default: 'Sætpris' }}</span>
              {%- if has_bundle -%}
                <span class="yy-lp-v">{{ bundle_cents | money_without_trailing_zeros }}</span>
              {%- elsif section.settings.bundle_price_text != blank -%}
                <span class="yy-lp-v">{{ section.settings.bundle_price_text }}</span>
              {%- endif -%}
            </div>

            {%- if savings_cents > 0 -%}
              <div class="yy-lp-setsum yy-lp-setsum--save">
                <span class="yy-lp-l">{{ section.settings.label_save | default: 'Du sparer' }}</span>
                <span class="yy-lp-v">{{ savings_cents | money_without_trailing_zeros }} ({{ savings_pct }}%)</span>
              </div>
            {%- elsif section.settings.bundle_savings_text != blank -%}
              <div class="yy-lp-setsum yy-lp-setsum--save">
                <span class="yy-lp-l">{{ section.settings.label_save | default: 'Du sparer' }}</span>
                <span class="yy-lp-v">{{ section.settings.bundle_savings_text }}</span>
              </div>
            {%- endif -%}

            {%- if has_bundle -%}
              <div class="yy-lp-setcta">
                <button
                  type="button"
                  class="yy-lp-btn yy-lp-btn--primary"
                  data-yylp-add-trigger
                  data-variant-id="{{ current_variant.id }}"
                  data-quantity="1">
                  {{ section.settings.cta_label | default: 'Læg i kurv' }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </div>
              <noscript>
                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <input type="hidden" name="return_to" value="/cart">
                  <button type="submit" class="yy-lp-btn yy-lp-btn--primary" style="width:100%;justify-content:center;margin-top:10px;">
                    {{ section.settings.cta_label | default: 'Læg i kurv' }}
                  </button>
                </form>
              </noscript>
            {%- endif -%}

            {%- if section.settings.guarantee_text != blank -%}
              <div class="yy-lp-guarantee">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
                <span>{{ section.settings.guarantee_text }}</span>
              </div>
            {%- endif -%}

            {%- assign pay_blocks = section.blocks | where: 'type', 'payment_icon' -%}
            {%- if section.settings.show_payment_icons and pay_blocks.size > 0 -%}
              <div class="yy-lp-payrow" aria-label="Betalingsmuligheder">
                {%- for block in pay_blocks -%}
                  {%- if block.settings.icon != blank -%}
                    {%- assign pay_h = 80 | times: block.settings.icon.height | divided_by: block.settings.icon.width -%}
                    <span class="yy-lp-pay" title="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
                      <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.label | escape }}" width="80" height="{{ pay_h }}" loading="lazy">
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP — Produkt (PDP)",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [
        { "value": "paper", "label": "Papir" },
        { "value": "white", "label": "Hvid" },
        { "value": "cream", "label": "Cremefarvet" }
      ],
      "default": "paper"
    },
    { "type": "header", "content": "Info-tekst" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Startsættet" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Dette sæt indeholder" },
    { "type": "textarea", "id": "lede", "label": "Brødtekst", "default": "To produkter. Alt det essentielle. En god start på et køkken uden plast." },
    { "type": "header", "content": "Sæt — salgbart produkt" },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundleprodukt",
      "info": "Dette produkt lægges i kurven. Prisen hentes automatisk herfra."
    },
    { "type": "text", "id": "bundle_price_text", "label": "Manuel sætpris (fallback)", "info": "Bruges kun hvis intet bundleprodukt er valgt" },
    { "type": "text", "id": "bundle_savings_text", "label": "Manuel besparelse (fallback)", "info": "Bruges kun hvis intet bundleprodukt er valgt" },
    { "type": "header", "content": "Tekster" },
    { "type": "text", "id": "label_compare", "label": "Tekst — købt separat", "default": "Købt separat" },
    { "type": "text", "id": "label_bundle", "label": "Tekst — sætpris", "default": "Sætpris" },
    { "type": "text", "id": "label_save", "label": "Tekst — besparelse", "default": "Du sparer" },
    { "type": "text", "id": "cta_label", "label": "Knaptekst", "default": "Læg i kurv" },
    { "type": "text", "id": "guarantee_text", "label": "Tryghedslinje", "default": "Du får fri fragt på dette sæt" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Vis betalingsikoner", "default": true }
  ],
  "blocks": [
    {
      "type": "gallery_video",
      "name": "Galleri — video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "label", "label": "Alt-tekst / label", "default": "Unboxing-video" }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Galleri — billede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "label", "label": "Alt-tekst / label" }
      ]
    },
    {
      "type": "set_row",
      "name": "Produkt i sættet",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "title_override", "label": "Navn (valgfri override)" },
        { "type": "text", "id": "subtitle", "label": "Undertekst", "info": "F.eks. «Stor madkasse med 3-rums skillevæg»" }
      ]
    },
    {
      "type": "payment_icon",
      "name": "Betalingsikon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Billede (f.eks. eget MobilePay/Klarna-logo)" },
        { "type": "text", "id": "label", "label": "Navn (alt-tekst)", "default": "Betalingsmetode" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Produkt (PDP)",
      "blocks": [
        { "type": "gallery_video" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "set_row" },
        { "type": "set_row" }
      ]
    }
  ]
}
{% endschema %}
