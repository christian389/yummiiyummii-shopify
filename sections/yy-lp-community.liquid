{% comment %}
  Yummii Yummii — Community (auto-scrollende billed-marquee)
  Selvstændig sektion (egen CSS, ingen afhængigheder). Billeder scroller
  automatisk i uendelig, sømløs løkke. To rækker som kører HVER SIN VEJ
  (kan slås fra → én række). Hastighed, retning, størrelse, pause-ved-hover
  m.m. styres i sektionens indstillinger.
  Upload som: sections/yy-lp-community.liquid — findes derefter under
  "Tilføj sektion" i editoren.
{% endcomment %}

{%- assign spd        = section.settings.speed | default: 60 -%}
{%- assign card_w     = section.settings.card_width | default: 300 -%}
{%- assign card_w_m   = card_w | times: 0.66 | round -%}
{%- assign img_h      = section.settings.image_height | default: 380 -%}
{%- assign img_h_m    = img_h | times: 0.72 | round -%}
{%- assign gap        = section.settings.gap | default: 16 -%}
{%- assign row_gap    = section.settings.row_gap | default: 16 -%}
{%- assign radius     = section.settings.radius | default: 14 -%}
{%- assign two_rows   = section.settings.two_rows -%}
{%- assign has_blocks = section.blocks.size -%}
{%- assign dirA_reverse = false -%}{%- if section.settings.direction == 'right' -%}{%- assign dirA_reverse = true -%}{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .yycm{
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .yycm__head{ max-width: 680px; margin: 0 auto 34px; padding: 0 22px; text-align: center; }
  #shopify-section-{{ section.id }} .yycm__eyebrow{ font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: {{ section.settings.accent_color | default: '#3d7a4f' }}; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .yycm__title{ font-size: clamp(24px, 3vw, 36px); line-height: 1.1; letter-spacing: -.02em; font-weight: 600; color: {{ section.settings.heading_color | default: '#1a1812' }}; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .yycm__intro{ font-size: 16px; line-height: 1.55; color: {{ section.settings.text_color | default: '#5a605a' }}; margin: 0; }

  #shopify-section-{{ section.id }} .yycm__rows{ display: flex; flex-direction: column; gap: {{ row_gap }}px; }
  #shopify-section-{{ section.id }} .yycm__viewport{
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  #shopify-section-{{ section.id }} .yycm__track{ display: flex; width: max-content; will-change: transform; }
  #shopify-section-{{ section.id }} .yycm__track--a{ animation: yycm-scroll-{{ section.id }} {{ spd }}s linear infinite;{% if dirA_reverse %} animation-direction: reverse;{% endif %} }
  #shopify-section-{{ section.id }} .yycm__track--b{ animation: yycm-scroll-{{ section.id }} {{ spd }}s linear infinite;{% unless dirA_reverse %} animation-direction: reverse;{% endunless %} }
  {% if section.settings.pause_on_hover %}#shopify-section-{{ section.id }} .yycm__viewport:hover .yycm__track{ animation-play-state: paused; }{% endif %}
  #shopify-section-{{ section.id }} .yycm__item{ flex: 0 0 {{ card_w }}px; margin-right: {{ gap }}px; }
  #shopify-section-{{ section.id }} .yycm__media{
    position: relative; display: block; width: {{ card_w }}px; height: {{ img_h }}px;
    border-radius: {{ radius }}px; overflow: hidden; background: #e9e4d5; text-decoration: none;
  }
  #shopify-section-{{ section.id }} .yycm__media img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .yycm__ph{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#9a958c; font-size:13px; text-align:center; padding:12px; }
  #shopify-section-{{ section.id }} .yycm__cap{
    position: absolute; left: 0; right: 0; bottom: 0; padding: 14px 16px;
    color: #fff; font-size: 13.5px; font-weight: 600; line-height: 1.3;
    background: linear-gradient(transparent, rgba(20,24,18,.6));
  }
  @keyframes yycm-scroll-{{ section.id }}{ from{ transform: translateX(0); } to{ transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce){ #shopify-section-{{ section.id }} .yycm__track{ animation: none; } }
  @media (max-width: 580px){
    #shopify-section-{{ section.id }} .yycm__item{ flex-basis: {{ card_w_m }}px; }
    #shopify-section-{{ section.id }} .yycm__media{ width: {{ card_w_m }}px; height: {{ img_h_m }}px; }
    #shopify-section-{{ section.id }} .yycm__head{ margin-bottom: 24px; }
  }
{% endstyle %}

<section class="yycm">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
    <header class="yycm__head">
      {%- if section.settings.eyebrow != blank -%}<p class="yycm__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="yycm__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="yycm__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </header>
  {%- endif -%}

  <div class="yycm__rows">
    {%- comment -%} RÆKKE A — lige billeder (index 0,2,4…). Enkelt-række-mode: alle billeder her. {%- endcomment -%}
    <div class="yycm__viewport">
      <div class="yycm__track yycm__track--a" role="list">
        {%- if has_blocks > 0 -%}
          {%- for pass in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- assign par = forloop.index0 | modulo: 2 -%}
              {%- if two_rows and par != 0 -%}{%- continue -%}{%- endif -%}
              <div class="yycm__item" role="listitem"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
                {%- capture media_inner -%}
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 700 }}"
                      srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                      sizes="{{ card_w }}px" alt="{{ block.settings.image.alt | escape }}"
                      width="{{ card_w }}" height="{{ img_h }}" loading="lazy" decoding="async">
                  {%- else -%}
                    <span class="yycm__ph">Billede</span>
                  {%- endif -%}
                  {%- if section.settings.show_caption and block.settings.caption != blank -%}<span class="yycm__cap">{{ block.settings.caption }}</span>{%- endif -%}
                {%- endcapture -%}
                {%- if block.settings.link != blank -%}
                  <a class="yycm__media" href="{{ block.settings.link }}">{{ media_inner }}</a>
                {%- else -%}
                  <div class="yycm__media">{{ media_inner }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for n in (1..6) -%}<div class="yycm__item"><div class="yycm__media"><span class="yycm__ph">Tilføj billede</span></div></div>{%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} RÆKKE B — ulige billeder (index 1,3,5…), kører modsat. Kun i to-række-mode. {%- endcomment -%}
    {%- if two_rows and has_blocks > 1 -%}
    <div class="yycm__viewport">
      <div class="yycm__track yycm__track--b" role="list">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- assign par = forloop.index0 | modulo: 2 -%}
            {%- if par != 1 -%}{%- continue -%}{%- endif -%}
            <div class="yycm__item" role="listitem"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
              {%- capture media_inner_b -%}
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 700 }}"
                    srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                    sizes="{{ card_w }}px" alt="{{ block.settings.image.alt | escape }}"
                    width="{{ card_w }}" height="{{ img_h }}" loading="lazy" decoding="async">
                {%- else -%}
                  <span class="yycm__ph">Billede</span>
                {%- endif -%}
                {%- if section.settings.show_caption and block.settings.caption != blank -%}<span class="yycm__cap">{{ block.settings.caption }}</span>{%- endif -%}
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                <a class="yycm__media" href="{{ block.settings.link }}">{{ media_inner_b }}</a>
              {%- else -%}
                <div class="yycm__media">{{ media_inner_b }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LP — Community",
  "tag": "section",
  "class": "yy-lp-community-section",
  "settings": [
    { "type": "header", "content": "Tekst (valgfri)" },
    { "type": "text", "id": "eyebrow", "label": "Overtekst", "default": "Vores community" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "En del af hverdagen hos +45.000 familier" },
    { "type": "textarea", "id": "intro", "label": "Introtekst" },
    { "type": "header", "content": "Bevægelse" },
    { "type": "checkbox", "id": "two_rows", "label": "To rækker (kører hver sin vej)", "default": true },
    { "type": "range", "id": "speed", "min": 15, "max": 120, "step": 5, "unit": "s", "label": "Sekunder pr. gennemløb", "default": 60, "info": "Højere = langsommere." },
    { "type": "select", "id": "direction", "label": "Retning (øverste række)", "options": [ { "value": "left", "label": "Mod venstre" }, { "value": "right", "label": "Mod højre" } ], "default": "left", "info": "Nederste række kører altid modsat." },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause når musen holdes over", "default": true },
    { "type": "header", "content": "Billeder" },
    { "type": "range", "id": "card_width", "min": 180, "max": 440, "step": 10, "unit": "px", "label": "Billedbredde", "default": 300 },
    { "type": "range", "id": "image_height", "min": 220, "max": 540, "step": 20, "unit": "px", "label": "Billedhøjde", "default": 380 },
    { "type": "range", "id": "gap", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Afstand mellem billeder", "default": 16 },
    { "type": "range", "id": "row_gap", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Afstand mellem rækker", "default": 16 },
    { "type": "range", "id": "radius", "min": 0, "max": 28, "step": 2, "unit": "px", "label": "Hjørne-radius", "default": 14 },
    { "type": "checkbox", "id": "show_caption", "label": "Vis billedtekst (overlay)", "default": true },
    { "type": "header", "content": "Farver & afstand" },
    { "type": "color", "id": "bg_color", "label": "Baggrund", "default": "#fbf9f2" },
    { "type": "color", "id": "heading_color", "label": "Overskrift", "default": "#1a1812" },
    { "type": "color", "id": "text_color", "label": "Introtekst", "default": "#5a605a" },
    { "type": "color", "id": "accent_color", "label": "Overtekst/accent", "default": "#3d7a4f" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bund", "default": 64 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Billede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "caption", "label": "Billedtekst (valgfri)" },
        { "type": "url", "id": "link", "label": "Link (valgfrit)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Community",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
