{% comment %}
  Yummii Yummii — Landingsside: Tryghed + galleri (kombineret mosaik)
  Blander tekst-punkter (ikon + titel + tekst) og billeder i ét tæt mosaik-grid.
  Billeder er fuldt udfaldende (object-fit: cover), ingen rammer/borders og
  minimal padding; tekst-felter har blød baggrund så de er læsbare.
  Blok-typer: 'point' (tekst) og 'photo' (billede). Størrelser: normal/wide/tall/big.
{% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}

{%- assign gap = section.settings.gap | default: 8 -%}
{%- assign radius = section.settings.radius | default: 10 -%}
{%- assign rowh = section.settings.row_height | default: 200 -%}

{% style %}
  #shopify-section-{{ section.id }} .yy-tg-grid{
    display:grid; grid-template-columns:repeat(4,1fr); grid-auto-rows:{{ rowh }}px;
    grid-auto-flow:dense; gap:{{ gap }}px; margin-top:26px;
  }
  #shopify-section-{{ section.id }} .yy-tg-tile{ position:relative; border-radius:{{ radius }}px; overflow:hidden; }
  #shopify-section-{{ section.id }} .yy-tg-tile--wide{ grid-column:span 2; }
  #shopify-section-{{ section.id }} .yy-tg-tile--tall{ grid-row:span 2; }
  #shopify-section-{{ section.id }} .yy-tg-tile--big{ grid-column:span 2; grid-row:span 2; }

  #shopify-section-{{ section.id }} .yy-tg-photo{ background:var(--yylp-soft,#efe9d8); display:flex; align-items:center; justify-content:center; text-align:center; color:var(--yylp-muted,#9a958c); font-size:13px; padding:10px; }
  #shopify-section-{{ section.id }} .yy-tg-photo img{ width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .yy-tg-cap{ position:absolute; left:0; right:0; bottom:0; padding:14px 16px; font-size:13px; font-weight:600; color:#fff; background:linear-gradient(0deg, rgba(20,28,18,.55), transparent); }

  #shopify-section-{{ section.id }} .yy-tg-point{ background:var(--yylp-card,#fff); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:9px; padding:22px 20px; }
  #shopify-section-{{ section.id }} .yy-tg-point .yy-tg-ic{ width:46px; height:46px; border-radius:50%; background:var(--yylp-soft,#f2efe8); color:var(--yylp-green,#3d7a4f); display:flex; align-items:center; justify-content:center; }
  #shopify-section-{{ section.id }} .yy-tg-point .yy-tg-ic svg{ width:22px; height:22px; }
  #shopify-section-{{ section.id }} .yy-tg-point h3{ margin:0; font-size:16px; font-weight:700; }
  #shopify-section-{{ section.id }} .yy-tg-point p{ margin:0; font-size:13.5px; line-height:1.45; color:var(--yylp-muted,#6f6a60); }

  @media (max-width:820px){
    #shopify-section-{{ section.id }} .yy-tg-grid{ grid-template-columns:repeat(2,1fr); grid-auto-rows:150px; }
    #shopify-section-{{ section.id }} .yy-tg-tile--big{ grid-column:span 2; grid-row:span 2; }
    #shopify-section-{{ section.id }} .yy-tg-tile--wide{ grid-column:span 2; }
    #shopify-section-{{ section.id }} .yy-tg-point{ padding:18px 14px; }
  }
{% endstyle %}

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section class="yy-lp-section">
    <div class="yy-lp-wrap">
      {%- if section.settings.heading != blank -%}<h2 class="yy-lp-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="yy-lp-intro">{{ section.settings.intro }}</p>{%- endif -%}

      <div class="yy-tg-grid">
        {%- for block in section.blocks -%}
          {%- assign sizeclass = '' -%}
          {%- if block.settings.layout == 'wide' -%}{%- assign sizeclass = 'yy-tg-tile--wide' -%}{%- elsif block.settings.layout == 'tall' -%}{%- assign sizeclass = 'yy-tg-tile--tall' -%}{%- elsif block.settings.layout == 'big' -%}{%- assign sizeclass = 'yy-tg-tile--big' -%}{%- endif -%}

          {%- if block.type == 'photo' -%}
            <div class="yy-tg-tile yy-tg-photo {{ sizeclass }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign tg_h = 900 | times: block.settings.image.height | divided_by: block.settings.image.width -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" width="900" height="{{ tg_h }}" loading="lazy">
              {%- else -%}
                {{ block.settings.placeholder_text | default: 'Billede' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="yy-tg-cap">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- elsif block.type == 'point' -%}
            <div class="yy-tg-tile yy-tg-point {{ sizeclass }}" {{ block.shopify_attributes }}>
              <span class="yy-tg-ic" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6.5 7 .9-5.2 4.9 1.4 7-6.2-3.5-6.2 3.5 1.4-7L2 9.4l7-.9z"/></svg>
                  {%- when 'refresh' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.6c0 4.5-8.8 10.4-8.8 10.4S3.2 13.1 3.2 8.6a4.6 4.6 0 0 1 8.8-1.9 4.6 4.6 0 0 1 8.8 1.9z"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21c8 0 14-6 14-14V4h-3C8 4 5 10 5 18v3z"/><path d="M5 21c3-6 6-9 12-12"/></svg>
                  {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5s7 8.2 7 12.7a7 7 0 0 1-14 0c0-4.5 7-12.7 7-12.7z"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endcase -%}
              </span>
              {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP — Tryghed + galleri",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [ { "value": "cream", "label": "Cremefarvet" }, { "value": "paper", "label": "Papir" }, { "value": "white", "label": "Hvid" } ],
      "default": "cream"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kun det vi selv ville bruge" },
    { "type": "textarea", "id": "intro", "label": "Introtekst", "default": "Udviklet af os, brugt af os. Fri for BPA og ftalater, testet efter FDA, LGFB og EU-standarder." },
    { "type": "header", "content": "Mosaik" },
    { "type": "range", "id": "row_height", "label": "Rækkehøjde (px)", "min": 140, "max": 280, "step": 10, "default": 200 },
    { "type": "range", "id": "gap", "label": "Afstand mellem felter (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "radius", "label": "Hjørne-radius (px)", "min": 0, "max": 24, "step": 2, "default": 10, "info": "0 = helt skarpe kanter (ingen ramme-følelse)." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Billede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "placeholder_text", "label": "Placeholder-tekst" },
        { "type": "text", "id": "caption", "label": "Billedtekst (valgfri, vises på billedet)" },
        {
          "type": "select", "id": "layout", "label": "Størrelse",
          "options": [ { "value": "normal", "label": "Normal (1×1)" }, { "value": "wide", "label": "Bred (2×1)" }, { "value": "tall", "label": "Høj (1×2)" }, { "value": "big", "label": "Stor (2×2)" } ],
          "default": "normal"
        }
      ]
    },
    {
      "type": "point",
      "name": "Tryghedspunkt (tekst)",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ikon",
          "options": [ { "value": "shield", "label": "Skjold (garanti)" }, { "value": "star", "label": "Stjerne (fragt)" }, { "value": "refresh", "label": "Retur" }, { "value": "heart", "label": "Hjerte (betaling)" }, { "value": "truck", "label": "Lastbil" }, { "value": "leaf", "label": "Blad" }, { "value": "drop", "label": "Dråbe" } ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Titel", "default": "10 års garanti" },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "På rustfrit stål. Køb det én gang." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Tryghed + galleri",
      "blocks": [
        { "type": "point" }, { "type": "photo", "settings": { "layout": "tall" } }, { "type": "photo", "settings": { "layout": "wide" } },
        { "type": "point" }, { "type": "photo" }, { "type": "point" }, { "type": "photo", "settings": { "layout": "wide" } }, { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
