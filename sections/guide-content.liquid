{% comment %}
  Guide -- consolidated "in-depth content" section (playbook sections 5-7):
  in-depth topic sections, audience/use-case cards, and practical use/care
  cards, each pulled from its own article metafield. Every subgroup renders
  independently and is skipped entirely if its metafield is empty, so a
  guide can ship with only some of the three filled in.

  Metafields (namespace: guide) -- field handles confirmed against the live
  metaobject definitions:
  - topic_sections -> Guide Topic Section: heading, body (rich text), image,
    badge_1/2/3, cta_text, cta_url
  - audience_cards -> Guide Audience Card: image, title, description, link_url
  - care_cards -> Guide Care Card: material_label, icon, tips

  Field values are read directly off each metaobject entry (e.g.
  topic.heading.value), not via a `.fields.` accessor -- see the note in
  sections/guide-comparison-table.liquid.
{% endcomment %}

{%- liquid
  assign topics = article.metafields.guide.topic_sections.value
  assign audience_cards = article.metafields.guide.audience_cards.value
  assign care_cards = article.metafields.guide.care_cards.value
  assign has_any = false
  if topics.size > 0 or audience_cards.size > 0 or care_cards.size > 0
    assign has_any = true
  endif

  assign topics_is_last = false
  assign audience_cards_is_last = false
  assign care_cards_is_last = false
  if care_cards.size > 0
    assign care_cards_is_last = true
  elsif audience_cards.size > 0
    assign audience_cards_is_last = true
  elsif topics.size > 0
    assign topics_is_last = true
  endif
-%}

{%- if has_any -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}

  <div class="guide">
    {%- if topics.size > 0 -%}
      <div class="guide-section{% if topics_is_last %} guide-section--last{% endif %}">
        {%- for topic in topics -%}
          {%- liquid
            assign topic_heading = topic.heading.value
            assign topic_id = topic_heading | handleize
            if topic_id == blank
              assign topic_id = 'emne-' | append: forloop.index
            endif
            assign topic_is_reversed = forloop.index0 | modulo: 2
          -%}
          <section
            class="guide-topic"
            id="{{ topic_id }}"
            {% if topic_heading != blank %}
              data-guide-toc-label="{{ topic_heading | escape }}"
            {% endif %}
          >
            <div class="guide-topic__grid {% if topic_is_reversed == 1 %}guide-topic__grid--reverse{% endif %}">
              <div>
                {%- if topic_heading != blank -%}
                  <h2 class="guide-heading">{{ topic_heading | escape }}</h2>
                {%- endif -%}
                {%- if topic.body.value != blank -%}
                  <div class="rte">{{ topic.body | metafield_tag }}</div>
                {%- endif -%}

                {%- liquid
                  assign badges = ''
                  if topic.badge_1.value != blank
                    assign badges = badges | append: topic.badge_1.value | append: '||'
                  endif
                  if topic.badge_2.value != blank
                    assign badges = badges | append: topic.badge_2.value | append: '||'
                  endif
                  if topic.badge_3.value != blank
                    assign badges = badges | append: topic.badge_3.value | append: '||'
                  endif
                  assign badge_list = badges | split: '||'
                -%}
                {%- if badge_list.size > 0 -%}
                  <div class="guide-topic__pills">
                    {%- for badge in badge_list -%}
                      <span class="guide-pill">{{ badge | escape }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if topic.cta_url.value != blank -%}
                  <a class="guide-topic__link" href="{{ topic.cta_url.value }}">
                    {{- topic.cta_text.value | default: section.settings.default_link_label | escape -}}
                  </a>
                {%- endif -%}
              </div>

              {%- if topic.image.value != blank -%}
                <div class="guide-topic__image">
                  {%- render 'lazy-image',
                    image: topic.image.value,
                    alt: topic_heading,
                    ratio: '1.33333',
                    sizes: '(max-width: 749px) 100vw, 50vw',
                    class: 'lazy-image--to-reveal'
                  -%}
                </div>
              {%- endif -%}
            </div>
          </section>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if audience_cards.size > 0 -%}
      <div
        class="guide-section{% if audience_cards_is_last %} guide-section--last{% endif %}"
        id="maalgruppe"
        {% if section.settings.audience_heading != blank %}
          data-guide-toc-label="{{ section.settings.audience_heading | escape }}"
        {% endif %}
      >
        {%- if section.settings.audience_heading != blank -%}
          <h2 class="guide-heading">{{ section.settings.audience_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.audience_intro != blank -%}
          <p class="guide-intro">{{ section.settings.audience_intro | escape }}</p>
        {%- endif -%}

        <div class="guide-card-grid">
          {%- for card in audience_cards -%}
            {%- assign card_tag = 'div' -%}
            {%- if card.link_url.value != blank -%}
              {%- assign card_tag = 'a' -%}
            {%- endif -%}
            <{{ card_tag }}
              class="guide-card"
              {% if card_tag == 'a' %}href="{{ card.link_url.value }}"{% endif %}
            >
              {%- if card.image.value != blank -%}
                <div class="guide-card__image">
                  {%- render 'lazy-image',
                    image: card.image.value,
                    alt: card.title.value,
                    ratio: '1.5',
                    sizes: '(max-width: 749px) 100vw, 33vw'
                  -%}
                </div>
              {%- endif -%}
              {%- if card.title.value != blank -%}
                <h3 class="guide-card__title">{{ card.title.value | escape }}</h3>
              {%- endif -%}
              {%- if card.description.value != blank -%}
                <p class="guide-card__body">{{ card.description.value | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if card.link_url.value != blank -%}
                <span class="guide-card__link">{{ section.settings.default_link_label | escape }}</span>
              {%- endif -%}
            </{{ card_tag }}>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if care_cards.size > 0 -%}
      <div
        class="guide-section{% if care_cards_is_last %} guide-section--last{% endif %}"
        id="rengoering"
        {% if section.settings.care_heading != blank %}
          data-guide-toc-label="{{ section.settings.care_heading | escape }}"
        {% endif %}
      >
        {%- if section.settings.care_heading != blank -%}
          <h2 class="guide-heading">{{ section.settings.care_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.care_intro != blank -%}
          <p class="guide-intro">{{ section.settings.care_intro | escape }}</p>
        {%- endif -%}

        <div class="guide-card-grid">
          {%- for card in care_cards -%}
            {%- liquid
              assign shape_index = forloop.index0 | modulo: 3
              case shape_index
                when 0
                  assign shape_class = 'guide-card__shape--square'
                when 1
                  assign shape_class = 'guide-card__shape--circle'
                else
                  assign shape_class = 'guide-card__shape--diamond'
              endcase
            -%}
            <div class="guide-card">
              <div class="guide-card__shape {{ shape_class }}" aria-hidden="true"></div>
              {%- if card.material_label.value != blank -%}
                <h3 class="guide-card__title">{{ card.material_label.value | escape }}</h3>
              {%- endif -%}
              {%- if card.tips.value != blank -%}
                {%- assign tip_lines = card.tips.value | newline_to_br | split: '<br />' -%}
                <div class="guide-card__body">
                  <ul>
                    {%- for tip in tip_lines -%}
                      {%- assign trimmed_tip = tip | strip -%}
                      {%- if trimmed_tip != blank -%}
                        <li>{{ trimmed_tip | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.content.name",
  "settings": [
    {
      "type": "text",
      "id": "default_link_label",
      "label": "t:guide.content.settings.default_link_label.label",
      "default": "Se sortimentet"
    },
    {
      "type": "header",
      "content": "t:guide.content.settings.audience_header.content"
    },
    {
      "type": "text",
      "id": "audience_heading",
      "label": "t:guide.content.settings.audience_heading.label",
      "default": "Find den rette til dig"
    },
    {
      "type": "text",
      "id": "audience_intro",
      "label": "t:guide.content.settings.audience_intro.label"
    },
    {
      "type": "header",
      "content": "t:guide.content.settings.care_header.content"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "t:guide.content.settings.care_heading.label",
      "default": "Rengøring og praktisk brug"
    },
    {
      "type": "text",
      "id": "care_intro",
      "label": "t:guide.content.settings.care_intro.label"
    }
  ],
  "presets": [
    {
      "name": "t:guide.content.name"
    }
  ]
}
{% endschema %}
