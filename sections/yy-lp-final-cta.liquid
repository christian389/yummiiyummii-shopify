{% comment %}Yummii Yummii — Landingsside: Final CTA{% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yy-landing.js' | asset_url }}" defer></script>

{%- liquid
  assign bundle_product = section.settings.bundle_product
  assign price_html = section.settings.price_text
  assign save_html = section.settings.save_text
  if bundle_product != blank
    assign bv = bundle_product.selected_or_first_available_variant
    assign price_html = bv.price | money_without_trailing_zeros
    if bv.compare_at_price and bv.compare_at_price > bv.price
      assign save_pct = bv.compare_at_price | minus: bv.price | times: 100 | divided_by: bv.compare_at_price | round
      assign save_html = 'Spar ' | append: save_pct | append: '%'
    endif
  endif
-%}

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section class="yy-lp-section yy-lp-final">
    <div class="yy-lp-wrap">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}

      {%- if price_html != blank -%}
        <div class="yy-lp-price">
          <span class="yy-lp-now">{{ price_html }}</span>
          {%- if save_html != blank -%}<span class="yy-lp-save">{{ save_html }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#kob' }}" class="yy-lp-btn yy-lp-btn--light" data-yylp-anchor>
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.reassure_text != blank -%}<div class="yy-lp-reassure">{{ section.settings.reassure_text }}</div>{%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP — Final CTA",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [ { "value": "green", "label": "Grøn" }, { "value": "dark", "label": "Mørk" } ],
      "default": "green"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Start din hverdag uden plast" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Bliv en af +45.000 kunder, der har skiftet plasten ud." },
    { "type": "header", "content": "Pris" },
    { "type": "product", "id": "bundle_product", "label": "Bundleprodukt" },
    { "type": "text", "id": "price_text", "label": "Manuel pris (fallback)" },
    { "type": "text", "id": "save_text", "label": "Manuel besparelse (fallback)" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_label", "label": "Knaptekst", "default": "Køb startsættet" },
    { "type": "url", "id": "cta_url", "label": "Knaplink (default: #kob)" },
    { "type": "text", "id": "reassure_text", "label": "Tryghedslinje", "default": "30 dages pengene-tilbage-garanti · Sikker betaling · Hurtig levering" }
  ],
  "presets": [ { "name": "LP — Final CTA" } ]
}
{% endschema %}
