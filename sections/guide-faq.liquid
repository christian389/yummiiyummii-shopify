{% comment %}
  Guide -- FAQ accordion (playbook section 9).

  Reads article.metafields.custom.faq_items (metaobject list, "Guide FAQ
  Item": question, answer). Renders nothing if empty. Mounts on the same
  toggle-tab/toggle-group web component as sections/content-toggles.liquid
  (component-toggle.js/css) rather than shipping new accordion JS.

  Also renders the FAQPage JSON-LD for this same data (snippets/
  guide-schema.liquid) -- Article and BreadcrumbList schema already emit
  automatically for every article page via snippets/microdata-schema.liquid,
  so only FAQPage needs building here.
{% endcomment %}

{%- liquid
  assign faq_items = article.metafields.custom.faq_items.value
-%}

{%- if faq_items and faq_items.size > 0 -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}
  {{ 'component-toggle.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'component-toggle.js' | asset_url }}" defer></script>

  {%- render 'guide-schema' -%}

  <div class="guide">
    <div
      class="guide-section"
      id="faq"
      data-guide-toc-label="{{ section.settings.heading | escape }}"
    >
      <h2 class="guide-heading">{{ section.settings.heading | escape }}</h2>

      <div class="guide-faq">
        <toggle-group>
          {%- for item in faq_items -%}
            {%- assign question = item.fields.question.value -%}
            {%- assign answer = item.fields.answer.value -%}
            {%- if question != blank and answer != blank -%}
              <toggle-tab class="toggle">
                <div
                  class="toggle__title"
                  data-js-title
                  tabindex="0"
                  aria-expanded="false"
                  role="button"
                  aria-controls="guide-faq-{{ section.id }}-{{ forloop.index }}"
                >
                  <span class="toggle__heading">{{ question | escape }}</span>
                </div>
                <div
                  id="guide-faq-{{ section.id }}-{{ forloop.index }}"
                  data-js-content
                  class="toggle__content rte"
                  role="region"
                >
                  {{ answer }}
                </div>
              </toggle-tab>
            {%- endif -%}
          {%- endfor -%}
        </toggle-group>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.faq.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:guide.faq.settings.heading.label",
      "default": "Ofte stillede spørgsmål"
    }
  ],
  "presets": [
    {
      "name": "t:guide.faq.name"
    }
  ]
}
{% endschema %}
