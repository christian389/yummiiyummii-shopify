{% comment %}
  Guide -- Quick answer callout (playbook section 2).
  Reads article.metafields.guide.quick_answer (multi-line text). Renders
  nothing if the article has no quick answer set, so a guide can be
  published incrementally without a broken empty box.
{% endcomment %}

{%- liquid
  assign quick_answer = article.metafields.guide.quick_answer.value
-%}

{%- if quick_answer != blank -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}

  <div class="guide">
    <div class="guide-section guide-section--first">
      <div class="guide-callout">
        <h2 class="guide-callout__label">{{ section.settings.label | escape }}</h2>
        <div class="guide-callout__text rte">{{ quick_answer | escape | newline_to_br }}</div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.quick_answer.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:guide.quick_answer.settings.label.label",
      "default": "Hurtigt svar"
    }
  ],
  "presets": [
    {
      "name": "t:guide.quick_answer.name"
    }
  ]
}
{% endschema %}
