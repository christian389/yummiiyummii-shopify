{% comment %}
  Guide -- Footer CTA band (the CTA half of playbook section 10).

  Reads article.metafields.guide.cta_heading (single line text) and
  article.metafields.guide.cta_url (URL). Falls back to the
  section's own settings when either metafield is blank, so the CTA still
  renders (with a sensible generic message) even before a guide's
  metafields are filled in.
{% endcomment %}

{%- liquid
  assign cta_heading = article.metafields.guide.cta_heading.value | default: section.settings.fallback_heading
  assign cta_link = article.metafields.guide.cta_url.value | default: section.settings.fallback_link
-%}

{%- if cta_heading != blank and cta_link != blank -%}
  {{ 'guide.css' | asset_url | stylesheet_tag }}

  <div class="guide">
    <div class="guide-cta">
      <div class="guide-cta__inner">
        <div>
          <h2 class="guide-cta__heading">{{ cta_heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="guide-cta__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        <a class="guide-cta__link" href="{{ cta_link }}">
          {{- section.settings.link_label | escape -}}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:guide.cta.name",
  "settings": [
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "t:guide.cta.settings.fallback_heading.label",
      "default": "Skal du i gang med den plastikfri madpakke?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:guide.cta.settings.subheading.label",
      "default": "Fri fragt over 400 kr. og 30 dages returret på hele sortimentet."
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "t:guide.cta.settings.fallback_link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:guide.cta.settings.link_label.label",
      "default": "Se alle produkter"
    }
  ],
  "presets": [
    {
      "name": "t:guide.cta.name"
    }
  ]
}
{% endschema %}
