{% comment %}Yummii Yummii — Landingsside: UGC video-carousel{% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yy-landing.js' | asset_url }}" defer></script>

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section class="yy-lp-section">
    <div class="yy-lp-wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="yy-lp-eyebrow" style="text-align:center">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="yy-lp-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="yy-lp-intro">{{ section.settings.intro }}</p>{%- endif -%}

      <div class="yy-lp-carousel" data-yylp-carousel>
        <button class="yy-lp-nav yy-lp-nav--prev" data-yylp-nav-prev aria-label="Forrige">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="yy-lp-track" data-yylp-track>
          {%- for block in section.blocks -%}
            {%- comment -%} Vælg en ~720p mp4-kilde (ikke tungeste 1080p) + poster-billede {%- endcomment -%}
            {%- assign vurl = '' -%}
            {%- assign poster_img = '' -%}
            {%- if block.settings.video != blank -%}
              {%- assign mp4s = block.settings.video.sources | where: 'format', 'mp4' | sort: 'height' -%}
              {%- if mp4s.size > 0 -%}
                {%- assign chosen = mp4s | first -%}
                {%- for s in mp4s -%}{%- if s.height >= 720 -%}{%- assign chosen = s -%}{%- break -%}{%- endif -%}{%- endfor -%}
                {%- assign vurl = chosen.url -%}
              {%- endif -%}
              {%- if block.settings.video.preview_image != blank -%}{%- assign poster_img = block.settings.video.preview_image | image_url: width: 600 -%}{%- endif -%}
            {%- endif -%}
            {%- if poster_img == blank and block.settings.image != blank -%}{%- assign poster_img = block.settings.image | image_url: width: 600 -%}{%- endif -%}
            <div class="yy-lp-vid" {{ block.shopify_attributes }}>
              {%- if vurl != blank -%}
                <video data-src="{{ vurl }}" preload="none" muted loop playsinline{% if poster_img != blank %} poster="{{ poster_img }}"{% endif %}></video>
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.image.alt | escape }}" width="500" height="889" loading="lazy">
              {%- else -%}
                <span class="yy-lp-ph">{{ block.settings.caption }}</span>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="yy-lp-cap">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <button class="yy-lp-nav yy-lp-nav--next" data-yylp-nav-next aria-label="Næste">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if(!root) return;
  var vids = root.querySelectorAll('video[data-src]');
  if(!vids.length) return;
  function load(v){ if(!v.getAttribute('src')){ v.setAttribute('src', v.getAttribute('data-src')); } }
  if(!('IntersectionObserver' in window)){
    // Fallback: kun første video autoloades
    load(vids[0]); var p0=vids[0].play&&vids[0].play(); if(p0&&p0.catch)p0.catch(function(){});
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      var v = e.target;
      if(e.isIntersecting){ load(v); var p=v.play&&v.play(); if(p&&p.catch)p.catch(function(){}); }
      else if(!v.paused){ v.pause(); }
    });
  }, { threshold: 0.4 });
  vids.forEach(function(v){ io.observe(v); });
})();
</script>

{% schema %}
{
  "name": "LP — UGC-carousel",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [ { "value": "paper", "label": "Papir" }, { "value": "white", "label": "Hvid" }, { "value": "cream", "label": "Cremefarvet" } ],
      "default": "paper"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Set af rigtige kunder" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Mød familierne der har skiftet plasten ud" },
    { "type": "textarea", "id": "intro", "label": "Introtekst", "default": "Ægte videoer fra hverdagen, hvor madkasserne forklares og bruges." }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Billede (fallback hvis ingen video)" },
        { "type": "text", "id": "caption", "label": "Billedtekst", "default": "\"Sådan pakker jeg madpakker uden plast\"" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — UGC-carousel",
      "blocks": [ { "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" } ]
    }
  ]
}
{% endschema %}
