{% comment %}
  Yummii Yummii — Back in Stock
  - Popup (navn + email + valgfri SMS) → Klaviyo Back-in-Stock client API
  - Produktside: knap ved udsolgte varer + auto-åbner efter X sek. (1x pr. session/produkt)
  - Collections + forside-grid: scanner udsolgte produktkort og indsætter knap
  Selvstændig sektion (egen CSS/JS). Placer den på PRODUKT-skabelonen (for knap +
  auto-popup) OG i en global sektion-gruppe / footer, så kort-scanneren kører overalt.
  Popup-markup flyttes til <body> ved load, så den aldrig klippes af tema-wrappers.
{% endcomment %}

{%- assign accent      = section.settings.accent | default: '#3d7a4f' -%}
{%- assign accent_dark = section.settings.accent_dark | default: '#2d5a3a' -%}
{%- assign key         = section.settings.klaviyo_public_key -%}

{%- comment -%} Produkt-kontekst: kun når sektionen ligger på en produktside og varen er udsolgt {%- endcomment -%}
{%- assign bis_soldout = false -%}
{%- if product and product.available == false -%}
  {%- assign bis_soldout = true -%}
  {%- assign bisv = product.variants | where: 'available', false | first -%}
  {%- unless bisv -%}{%- assign bisv = product.variants.first -%}{%- endunless -%}
{%- endif -%}

{% style %}
  .yybis-overlay{ position:fixed; inset:0; z-index:100000; display:none; align-items:center; justify-content:center; padding:22px; background:rgba(20,28,18,.55); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px);
    font-family:'DM Sans',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --g:{{ accent }}; --gd:{{ accent_dark }}; --gdeep:#243f2c; --cream:#f4eedb; --cream2:#efe9d8; --paper:#fbf9f2; --ink:#1a1812; --muted:#8a8f88; --red:#c0392b; --line:#e6e2d4; }
  .yybis-overlay.is-open{ display:flex; animation:yybis-fade .25s ease; }
  html.yybis-lock, body.yybis-lock{ overflow:hidden; }
  @keyframes yybis-fade{ from{opacity:0} to{opacity:1} }
  @keyframes yybis-pop{ from{opacity:0; transform:translateY(16px) scale(.97)} to{opacity:1; transform:none} }
  .yybis-overlay *{ box-sizing:border-box; }
  .yybis-pop{ position:relative; background:var(--paper); color:var(--ink); border-radius:20px; overflow:hidden; box-shadow:0 40px 90px -30px rgba(0,0,0,.6); animation:yybis-pop .32s cubic-bezier(.2,.8,.25,1); width:440px; max-width:calc(100vw - 44px); line-height:1.5; }
  .yybis-close{ position:absolute; top:14px; right:14px; z-index:6; width:34px; height:34px; border-radius:50%; border:none; background:rgba(255,255,255,.85); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:.15s; }
  .yybis-close:hover{ background:#fff; transform:rotate(90deg); }
  .yybis-close svg{ width:16px; height:16px; }
  .yybis-head{ display:flex; gap:15px; align-items:center; padding:26px 26px 0; }
  .yybis-thumb{ width:76px; height:76px; border-radius:14px; overflow:hidden; flex-shrink:0; background:var(--cream2); display:flex; align-items:center; justify-content:center; }
  .yybis-thumb img{ width:100%; height:100%; object-fit:cover; }
  .yybis-status{ display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--red); background:#fbe9e6; padding:4px 9px; border-radius:999px; margin-bottom:7px; }
  .yybis-status .d{ width:6px; height:6px; border-radius:50%; background:var(--red); }
  .yybis-name{ font-size:18px; font-weight:600; letter-spacing:-.01em; line-height:1.15; }
  .yybis-var{ font-size:13px; color:var(--muted); margin-top:2px; }
  .yybis-var:empty{ display:none; }
  .yybis-body{ padding:20px 26px 26px; }
  .yybis-h{ font-size:22px; font-weight:600; letter-spacing:-.02em; line-height:1.15; margin-bottom:8px; }
  .yybis-lead{ font-size:14.5px; color:#5a605a; margin-bottom:18px; }
  .yybis-form{ display:flex; flex-direction:column; gap:10px; }
  .yybis-inp{ position:relative; }
  .yybis-inp>svg{ position:absolute; left:14px; top:50%; transform:translateY(-50%); width:17px; height:17px; color:var(--muted); pointer-events:none; }
  .yybis-inp input{ width:100%; font-family:inherit; font-size:15px; padding:14px 16px 14px 42px; border:1px solid var(--line); border-radius:12px; background:#fff; color:var(--ink); outline:none; transition:.15s; }
  .yybis-inp input:focus{ border-color:var(--g); box-shadow:0 0 0 3px rgba(61,122,79,.15); }
  .yybis-field{ display:none; }
  .yybis-field.show{ display:block; }
  .yybis-smsopt{ display:flex; align-items:center; gap:11px; background:var(--cream); border:1px solid var(--line); border-radius:12px; padding:13px 15px; cursor:pointer; transition:.15s; }
  .yybis-smsopt:hover{ border-color:var(--g); }
  .yybis-smsopt input{ width:18px; height:18px; accent-color:var(--g); flex-shrink:0; cursor:pointer; }
  .yybis-smsopt span{ flex:1; display:flex; flex-direction:column; line-height:1.25; }
  .yybis-smsopt span b{ font-size:14px; font-weight:600; color:var(--ink); }
  .yybis-smsopt span em{ font-size:12px; color:var(--muted); font-style:normal; margin-top:1px; }
  .yybis-smsopt .sms-ic{ width:20px; height:20px; color:var(--g); flex-shrink:0; }
  .yybis-smsopt.on{ background:#eef3e6; border-color:var(--g); }
  .yybis-btn{ border:none; border-radius:12px; padding:15px; font-family:inherit; font-size:15px; font-weight:600; background:var(--g); color:var(--cream); display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; transition:.16s; }
  .yybis-btn:hover{ background:var(--gd); transform:translateY(-1px); }
  .yybis-btn[disabled]{ opacity:.6; pointer-events:none; }
  .yybis-btn svg{ width:17px; height:17px; }
  .yybis-consent{ display:flex; gap:10px; align-items:flex-start; font-size:12px; color:#5a605a; line-height:1.5; margin-top:2px; cursor:pointer; background:var(--cream); border:1px solid var(--line); border-radius:12px; padding:12px 14px; }
  .yybis-consent:hover{ border-color:var(--g); }
  .yybis-consent input{ margin-top:1px; accent-color:var(--g); width:17px; height:17px; flex-shrink:0; }
  .yybis-consent a{ color:var(--g); text-decoration:underline; }
  .yybis-err{ font-size:12.5px; color:var(--red); display:none; }
  .yybis-err.show{ display:block; }
  .yybis-success{ display:none; text-align:center; padding:40px 34px 34px; }
  .yybis-pop.done .yybis-head, .yybis-pop.done .yybis-body{ display:none; }
  .yybis-pop.done .yybis-success{ display:block; animation:yybis-fade .3s; }
  .yybis-check{ width:66px; height:66px; border-radius:50%; background:var(--g); color:#fff; display:flex; align-items:center; justify-content:center; margin:0 auto 18px; animation:yybis-pop .4s; }
  .yybis-check svg{ width:32px; height:32px; }
  .yybis-success h2{ font-size:23px; font-weight:600; letter-spacing:-.02em; margin-bottom:10px; }
  .yybis-success p{ font-size:14.5px; color:#5a605a; }
  .yybis-again{ margin-top:20px; background:none; border:none; color:var(--muted); font-size:13px; font-weight:600; text-decoration:underline; cursor:pointer; }
  .yybis-again:hover{ color:var(--ink); }
  @media(max-width:480px){ .yybis-pop{ width:100%; } .yybis-head{ padding:22px 20px 0; } .yybis-body{ padding:18px 20px 22px; } }

  /* Knap injiceret på udsolgte produktkort + produktside */
  .yybis-cardbtn{ display:inline-flex; align-items:center; justify-content:center; gap:7px; width:100%; margin-top:8px; border:1.5px solid {{ accent }}; background:{{ accent }} !important; color:#f4eedb !important; border-radius:999px; padding:10px 16px; font-family:'DM Sans',system-ui,sans-serif; font-size:13.5px; font-weight:600; cursor:pointer; transition:.15s; line-height:1.2; text-decoration:none; }
  .yybis-cardbtn:hover{ background:{{ accent_dark }} !important; border-color:{{ accent_dark }}; color:#fff !important; }
  .yybis-cardbtn svg{ width:16px !important; height:16px !important; flex:0 0 16px; color:inherit; stroke:currentColor; }
  .yybis-cardbtn--product{ width:auto; padding:14px 26px; font-size:15px; }
  .yybis-cardbtn--replace{ width:100%; padding:15px 26px; font-size:15px; margin-top:0; }
{% endstyle %}

<div class="yybis-overlay" data-yybis-overlay
  data-key="{{ key }}"
  data-enable-sms="{% if section.settings.enable_sms %}1{% else %}0{% endif %}"
  data-enable-auto="{% if section.settings.enable_auto %}1{% else %}0{% endif %}"
  data-auto-delay="{{ section.settings.auto_delay | default: 10 }}"
  data-badge="{{ section.settings.badge_text | default: 'Udsolgt' | escape }}"
  data-cardsel="{{ section.settings.card_selector | escape }}"
  data-btnlabel="{{ section.settings.button_label | default: 'Giv besked når tilbage' | escape }}"
  data-replace-atc="{% if section.settings.replace_atc %}1{% else %}0{% endif %}"
  data-list="{{ section.settings.marketing_list_id | escape }}"
  data-sms-region="{{ section.settings.sms_country_code | default: '+45' }}">
  <div class="yybis-pop" data-yybis-pop role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | default: 'Få besked når den er tilbage' | escape }}">
    <button class="yybis-close" data-yybis-close aria-label="Luk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

    <div class="yybis-head">
      <div class="yybis-thumb"><img data-yybis-img src="" alt="" width="76" height="76"></div>
      <div class="meta">
        <span class="yybis-status"><span class="d"></span>{{ section.settings.soldout_label | default: 'Udsolgt' }}</span>
        <h3 class="yybis-name" data-yybis-name></h3>
        <div class="yybis-var" data-yybis-var></div>
      </div>
    </div>

    <div class="yybis-body">
      <h2 class="yybis-h">{{ section.settings.heading | default: 'Få besked når den er tilbage' }}</h2>
      <p class="yybis-lead">{{ section.settings.lead | default: 'Skriv dig op, så giver vi lyd, så snart den er på lager igen. Du er ikke bundet til noget.' }}</p>

      <form class="yybis-form" data-yybis-form novalidate>
        <div class="yybis-inp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
          <input type="text" data-yybis-fname placeholder="{{ section.settings.name_placeholder | default: 'Dit fornavn' | escape }}" autocomplete="given-name" required>
        </div>
        <div class="yybis-inp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg>
          <input type="email" data-yybis-email placeholder="{{ section.settings.email_placeholder | default: 'Din e-mail' | escape }}" autocomplete="email" required>
        </div>

        {%- if section.settings.enable_sms -%}
        <label class="yybis-smsopt" data-yybis-smstoggle>
          <input type="checkbox" data-yybis-wantsms>
          <span><b>{{ section.settings.sms_label | default: 'Send mig også en SMS' }}</b><em>{{ section.settings.sms_sub | default: 'Hurtigst muligt — direkte på mobilen' }}</em></span>
          <svg class="sms-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H8l-4 4z"/></svg>
        </label>
        <div class="yybis-inp yybis-field" data-yybis-fphone>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/></svg>
          <input type="tel" data-yybis-phone placeholder="{{ section.settings.phone_placeholder | default: 'Dit mobilnummer' | escape }}" autocomplete="tel">
        </div>
        {%- endif -%}

        <label class="yybis-consent"><input type="checkbox" data-yybis-consent><span data-yybis-consenttxt>{{ section.settings.consent_text | default: 'Ja tak, send mig en besked når varen er på lager. Se vores privatlivspolitik.' }}</span></label>
        <div class="yybis-err" data-yybis-err></div>
        <button type="submit" class="yybis-btn" data-yybis-submit><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>{{ section.settings.submit_label | default: 'Giv mig besked' }}</button>
      </form>
    </div>

    <div class="yybis-success">
      <div class="yybis-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></div>
      <h2>{{ section.settings.success_heading | default: 'Du er på listen!' }}</h2>
      <p data-yybis-donetxt></p>
      <button class="yybis-again" data-yybis-again>{{ section.settings.again_label | default: 'Skriv en anden op' }}</button>
    </div>
  </div>
</div>

{%- if bis_soldout -%}
  <div data-yybis-product
    data-title="{{ product.title | escape }}"
    data-var="{% unless bisv.title contains 'Default' %}{{ bisv.title | escape }}{% endunless %}"
    data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}"
    data-variant-id="{{ bisv.id }}"
    data-show-btn="{% if section.settings.show_product_button %}1{% else %}0{% endif %}"
    style="display:none"></div>
{%- endif -%}

<script>
(function(){
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if(!section) return;
  var ov = section.querySelector('[data-yybis-overlay]');
  if(!ov) return;
  // Singleton: hvis sektionen ligger flere steder, kører kun den første. Fjern dublet-overlays.
  if(window.__yybisActive){ if(ov.parentNode){ ov.parentNode.removeChild(ov); } return; }
  window.__yybisActive = true;
  ov.dataset.yybisInit = '1';

  // Flyt overlay til <body> så den ikke klippes af tema-wrappers
  document.body.appendChild(ov);

  var cfg = {
    key: ov.getAttribute('data-key') || '',
    sms: ov.getAttribute('data-enable-sms') === '1',
    auto: ov.getAttribute('data-enable-auto') === '1',
    delay: (parseFloat(ov.getAttribute('data-auto-delay')) || 10) * 1000,
    badge: (ov.getAttribute('data-badge') || 'Udsolgt').toLowerCase(),
    cardSel: ov.getAttribute('data-cardsel') || '',
    btnLabel: ov.getAttribute('data-btnlabel') || 'Giv besked når tilbage',
    replace: ov.getAttribute('data-replace-atc') === '1',
    list: ov.getAttribute('data-list') || '',
    region: ov.getAttribute('data-sms-region') || '+45'
  };

  var pop = ov.querySelector('[data-yybis-pop]');
  var q = function(s){ return ov.querySelector(s); };
  var current = { title:'', variantId:'', handle:'' };

  function fill(ctx){
    current = ctx || {};
    var img = q('[data-yybis-img]');
    if(ctx.image){ img.src = ctx.image; img.style.display=''; } else { img.style.display='none'; }
    q('[data-yybis-name]').textContent = ctx.title || '';
    q('[data-yybis-var]').textContent = ctx.variant || '';
    pop.classList.remove('done');
    var f = q('[data-yybis-form]'); if(f) f.reset();
    var err = q('[data-yybis-err]'); if(err) err.classList.remove('show');
    if(cfg.sms) syncSms();
  }
  function open(){ ov.classList.add('is-open'); document.documentElement.classList.add('yybis-lock'); document.body.classList.add('yybis-lock'); }
  function close(){ ov.classList.remove('is-open'); document.documentElement.classList.remove('yybis-lock'); document.body.classList.remove('yybis-lock'); }

  // SMS toggle
  function syncSms(){
    var want = q('[data-yybis-wantsms]'); if(!want) return;
    var on = want.checked;
    q('[data-yybis-smstoggle]').classList.toggle('on', on);
    var fp = q('[data-yybis-fphone]'); if(fp) fp.classList.toggle('show', on);
    var ph = q('[data-yybis-phone]'); if(ph) ph.required = on;
  }
  if(cfg.sms){ var w=q('[data-yybis-wantsms]'); if(w) w.addEventListener('change', syncSms); }

  // Luk
  ov.querySelectorAll('[data-yybis-close]').forEach(function(b){ b.addEventListener('click', close); });
  ov.addEventListener('click', function(e){ if(e.target === ov) close(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && ov.classList.contains('is-open')) close(); });
  var again = q('[data-yybis-again]'); if(again) again.addEventListener('click', function(){ pop.classList.remove('done'); });

  // Submit → Klaviyo Back-in-Stock
  q('[data-yybis-form]').addEventListener('submit', function(e){
    e.preventDefault();
    var err = q('[data-yybis-err]');
    var name = (q('[data-yybis-fname]').value||'').trim();
    var email = (q('[data-yybis-email]').value||'').trim();
    var consent = q('[data-yybis-consent]');
    var wantSms = cfg.sms && q('[data-yybis-wantsms]') && q('[data-yybis-wantsms]').checked;
    var phoneEl = q('[data-yybis-phone]');
    var phone = phoneEl ? (phoneEl.value||'').trim() : '';
    function fail(m){ err.textContent = m; err.classList.add('show'); }
    if(name.length < 1){ return fail('Skriv dit fornavn.'); }
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ return fail('Tjek din e-mail.'); }
    if(wantSms && phone.replace(/\D/g,'').length < 6){ return fail('Skriv et gyldigt mobilnummer.'); }
    if(consent && !consent.checked){ return fail('Sæt flueben i samtykke.'); }
    if(!current.variantId){ return fail('Produktet kunne ikke findes. Prøv igen.'); }
    err.classList.remove('show');

    var channels = ['EMAIL'];
    var e164 = '';
    if(wantSms && phone){
      e164 = phone.charAt(0) === '+' ? phone.replace(/[^\d+]/g,'') : cfg.region + phone.replace(/\D/g,'');
      channels.push('SMS');
    }
    var submitBtn = q('[data-yybis-submit]'); if(submitBtn) submitBtn.setAttribute('disabled','');

    // 1) Marketing-liste (gemmer også navn + samtykke). Uden liste-id: gem blot profilen med navn.
    try {
      var pAttrs = { email: email, first_name: name };
      if(e164){ pAttrs.phone_number = e164; }
      if(cfg.list){
        fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(cfg.key), {
          method:'POST', headers:{ 'Content-Type':'application/json', 'revision':'2024-10-15' },
          body: JSON.stringify({ data:{ type:'subscription', attributes:{
            custom_source: 'Back in stock popup',
            profile:{ data:{ type:'profile', attributes: pAttrs } }
          }, relationships:{ list:{ data:{ type:'list', id: cfg.list } } } } })
        }).catch(function(){});
      } else {
        fetch('https://a.klaviyo.com/client/profiles/?company_id=' + encodeURIComponent(cfg.key), {
          method:'POST', headers:{ 'Content-Type':'application/json', 'revision':'2024-10-15' },
          body: JSON.stringify({ data:{ type:'profile', attributes: pAttrs } })
        }).catch(function(){});
      }
    } catch(_){}

    // 2) Selve Back-in-Stock-tilmeldingen — kun identifikatorer (email/telefon), ingen first_name.
    var bisAttrs = { email: email };
    if(e164){ bisAttrs.phone_number = e164; }

    fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + encodeURIComponent(cfg.key), {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'revision':'2024-10-15' },
      body: JSON.stringify({ data:{ type:'back-in-stock-subscription', attributes:{
        profile:{ data:{ type:'profile', attributes: bisAttrs } },
        channels: channels
      }, relationships:{ variant:{ data:{ type:'catalog-variant', id:'$shopify:::$default:::' + current.variantId } } } } })
    }).then(function(r){
      if(submitBtn) submitBtn.removeAttribute('disabled');
      if(r.status >= 200 && r.status < 300){
        q('[data-yybis-donetxt]').innerHTML = (wantSms
          ? 'Vi sender dig en <b>email og SMS</b>, så snart <b>' : 'Vi sender dig en <b>email</b>, så snart <b>')
          + (current.title || 'varen') + '</b> er tilbage på lager.';
        pop.classList.add('done');
        try{ window.dispatchEvent(new CustomEvent('yy:backInStockSignup', { detail: current })); }catch(_){}
      } else { fail('Noget gik galt. Prøv igen om lidt.'); }
    }).catch(function(){ if(submitBtn) submitBtn.removeAttribute('disabled'); fail('Noget gik galt. Prøv igen om lidt.'); });
  });

  // Åbn fra en knap med data-attributter
  function openFromEl(el){
    fill({ title: el.getAttribute('data-title')||'', variant: el.getAttribute('data-var')||'', image: el.getAttribute('data-image')||'', variantId: el.getAttribute('data-variant-id')||'' });
    open();
  }
  document.addEventListener('click', function(e){
    var t = e.target.closest('[data-yybis-open]');
    if(t){ e.preventDefault(); openFromEl(t); return; }
    var card = e.target.closest('[data-yybis-cardbtn]');
    if(card){ e.preventDefault(); openFromCard(card); }
  });

  var BELL = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;flex:0 0 16px"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>';
  var pctx = section.querySelector('[data-yybis-product]') || document.querySelector('[data-yybis-product]');

  // ---- Produktside: injicér knap ved købsknappen (uanset hvor sektionen er placeret) ----
  if(pctx && pctx.getAttribute('data-variant-id') && pctx.getAttribute('data-show-btn') === '1'){
    if(!document.querySelector('.yybis-cardbtn--product')){
      var pb = document.createElement('button');
      pb.type = 'button';
      pb.className = 'yybis-cardbtn yybis-cardbtn--product';
      pb.setAttribute('data-yybis-open','1');
      pb.setAttribute('data-title', pctx.getAttribute('data-title')||'');
      pb.setAttribute('data-var', pctx.getAttribute('data-var')||'');
      pb.setAttribute('data-image', pctx.getAttribute('data-image')||'');
      pb.setAttribute('data-variant-id', pctx.getAttribute('data-variant-id')||'');
      pb.innerHTML = BELL + ' ' + cfg.btnLabel;
      var addBtn = document.querySelector('form[action*="/cart/add"] .add-to-cart, form[action*="/cart/add"] button[name="add"], form[action*="/cart/add"] [type="submit"], .add-to-cart, product-form button[name="add"]');
      if(cfg.replace && addBtn && addBtn.parentNode){
        // Erstat den udsolgte købsknap
        pb.classList.add('yybis-cardbtn--replace');
        addBtn.style.display = 'none';
        // skjul evt. Shop Pay / dynamic checkout ved siden af
        var dyn = document.querySelector('.shopify-payment-button, [data-shopify="payment-button"]'); if(dyn) dyn.style.display = 'none';
        addBtn.parentNode.insertBefore(pb, addBtn.nextSibling);
      } else {
        var wrap = document.createElement('div'); wrap.style.marginTop = '14px'; wrap.appendChild(pb);
        var form = document.querySelector('form[action*="/cart/add"]');
        if(form && form.parentNode){ form.parentNode.insertBefore(wrap, form.nextSibling); }
        else if(pctx.parentNode){ pctx.parentNode.insertBefore(wrap, pctx.nextSibling); }
      }
    }
  }

  // ---- Produktside: auto-åbn efter X sek (1x pr. session/produkt) ----
  if(cfg.auto && pctx && pctx.getAttribute('data-variant-id')){
    var handleKey = 'yybis_seen_' + (location.pathname || '');
    var seen = false;
    try{ seen = !!sessionStorage.getItem(handleKey); }catch(_){}
    if(!seen){
      setTimeout(function(){
        if(ov.classList.contains('is-open')) return;
        fill({ title: pctx.getAttribute('data-title')||'', variant: pctx.getAttribute('data-var')||'', image: pctx.getAttribute('data-image')||'', variantId: pctx.getAttribute('data-variant-id')||'' });
        open();
        try{ sessionStorage.setItem(handleKey, '1'); }catch(_){}
      }, cfg.delay);
    }
  }

  // ---- Kort-scanner: find udsolgte produktkort og indsæt knap ----
  var CARD_SEL = cfg.cardSel && cfg.cardSel.trim().length ? cfg.cardSel : '.product-item';

  function openFromCard(btn){
    var handle = btn.getAttribute('data-handle');
    if(!handle){ return; }
    if(btn.getAttribute('data-variant-id')){ return openFromEl(btn); }
    btn.setAttribute('disabled','');
    fetch('/products/' + handle + '.js')
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(p){
        btn.removeAttribute('disabled');
        if(!p){ return; }
        var v = null;
        for(var i=0;i<p.variants.length;i++){ if(!p.variants[i].available){ v=p.variants[i]; break; } }
        if(!v) v = p.variants[0];
        var img = (p.featured_image || (p.images&&p.images[0]) || '');
        openFromEl2({ title: p.title, variant: (v.title && v.title.indexOf('Default')<0)?v.title:'', image: img, variantId: String(v.id) });
      }).catch(function(){ btn.removeAttribute('disabled'); });
  }
  function openFromEl2(ctx){ fill(ctx); open(); }

  function scan(){
    var soldLabel = cfg.badge; // fx 'udsolgt' (lowercased)
    document.querySelectorAll(CARD_SEL).forEach(function(card){
      if(card.getAttribute('data-yybis-done')) return;
      // ekskludér mega-menu-kort + produktsidens hovedområde
      if(card.closest('.yy-mega') || card.closest('[data-yybis-product]')) return;
      // temaets købsknap på kortet — den eneste pålidelige udsolgt-indikator
      var addBtn = card.querySelector('.add-to-cart')
        || card.querySelector('form[action*="/cart/add"] [type="submit"]')
        || card.querySelector('button[name="add"]');
      if(!addBtn) return; // ikke et rigtigt produktkort (endnu) — prøv igen senere
      var label = (addBtn.textContent || '').trim().toLowerCase();
      if(label.indexOf(soldLabel) === -1){ card.setAttribute('data-yybis-done','1'); return; } // på lager → spring over
      var link = card.querySelector('a[href*="/products/"]');
      if(!link){ return; }
      var m = link.getAttribute('href').match(/\/products\/([^/?#]+)/);
      if(!m){ return; }
      if(card.querySelector('.yybis-cardbtn')){ card.setAttribute('data-yybis-done','1'); return; }
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'yybis-cardbtn';
      b.setAttribute('data-yybis-cardbtn','1');
      b.setAttribute('data-handle', m[1]);
      b.innerHTML = BELL + ' ' + cfg.btnLabel;
      if(cfg.replace && addBtn.parentNode){
        b.classList.add('yybis-cardbtn--replace');
        addBtn.style.display = 'none';
        addBtn.parentNode.insertBefore(b, addBtn.nextSibling);
      } else if(addBtn.parentNode){
        addBtn.parentNode.insertBefore(b, addBtn.nextSibling);
      } else {
        card.appendChild(b);
      }
      card.setAttribute('data-yybis-done','1');
    });
  }

  if(document.readyState !== 'loading'){ scan(); } else { document.addEventListener('DOMContentLoaded', scan); }
  // Kør igen ved AJAX-opdateringer (filtrering/paginering)
  var t; var mo = new MutationObserver(function(){ clearTimeout(t); t = setTimeout(scan, 300); });
  try{ mo.observe(document.body, { childList:true, subtree:true }); }catch(_){}
})();
</script>

