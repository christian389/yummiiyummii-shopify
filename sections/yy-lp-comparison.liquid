{% comment %}Yummii Yummii — Landingsside: Sammenligningstabel{% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}

<div class="yy-lp-root yy-lp-scheme--{{ section.settings.color_scheme }}">
  <section class="yy-lp-section">
    <div class="yy-lp-wrap">
      {%- if section.settings.heading != blank -%}<h2 class="yy-lp-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="yy-lp-intro">{{ section.settings.intro }}</p>{%- endif -%}

      <div class="yy-lp-cmp-table">
        <div class="yy-lp-cmp-head">
          <div>&nbsp;</div>
          <div>
            {%- if section.settings.icon_position == 'above' and section.settings.competitor_icon != blank -%}
              <img class="yy-lp-cmp-icon" src="{{ section.settings.competitor_icon | image_url: width: 68 }}" alt="" width="68" height="68" loading="lazy">
            {%- endif -%}
            {{ section.settings.competitor_label | default: 'Plastbokse' }}
            {%- if section.settings.icon_position == 'below' and section.settings.competitor_icon != blank -%}
              <img class="yy-lp-cmp-icon yy-lp-cmp-icon--below" src="{{ section.settings.competitor_icon | image_url: width: 68 }}" alt="" width="68" height="68" loading="lazy">
            {%- endif -%}
          </div>
          <div class="yy-lp-ours">
            {%- if section.settings.icon_position == 'above' and section.settings.our_icon != blank -%}
              <img class="yy-lp-cmp-icon" src="{{ section.settings.our_icon | image_url: width: 68 }}" alt="" width="68" height="68" loading="lazy">
            {%- endif -%}
            {{ section.settings.our_label | default: 'Yummii Yummii stål' }}
            {%- if section.settings.icon_position == 'below' and section.settings.our_icon != blank -%}
              <img class="yy-lp-cmp-icon yy-lp-cmp-icon--below" src="{{ section.settings.our_icon | image_url: width: 68 }}" alt="" width="68" height="68" loading="lazy">
            {%- endif -%}
          </div>
        </div>
        {%- for block in section.blocks -%}
          <div class="yy-lp-cmp-line" {{ block.shopify_attributes }}>
            <div class="yy-lp-feat">{{ block.settings.feature }}</div>
            <div class="yy-lp-no">{{ block.settings.competitor_answer }}</div>
            <div class="yy-lp-ours yy-lp-yes">{{ block.settings.our_answer }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP — Sammenligning",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farveskema",
      "options": [ { "value": "dark", "label": "Mørk" }, { "value": "green", "label": "Grøn" } ],
      "default": "dark"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Plast vs. rustfrit stål" },
    { "type": "textarea", "id": "intro", "label": "Introtekst", "default": "Den samme madkasse, to vidt forskellige materialer." },
    { "type": "text", "id": "competitor_label", "label": "Kolonne — konkurrent", "default": "Plastbokse" },
    { "type": "text", "id": "our_label", "label": "Kolonne — os", "default": "Yummii Yummii stål" },
    { "type": "header", "content": "Mikroikoner" },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Placering",
      "options": [
        { "value": "above", "label": "Over overskrift" },
        { "value": "below", "label": "Under overskrift" }
      ],
      "default": "above"
    },
    { "type": "image_picker", "id": "competitor_icon", "label": "Ikon — konkurrent (plastbøtte)" },
    { "type": "image_picker", "id": "our_icon", "label": "Ikon — os (stål-madkasse)" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Sammenligningslinje",
      "settings": [
        { "type": "text", "id": "feature", "label": "Egenskab", "default": "Afgiver mikroplast i maden" },
        { "type": "text", "id": "competitor_answer", "label": "Konkurrent-svar", "default": "Risiko, især ved varme" },
        { "type": "text", "id": "our_answer", "label": "Vores svar", "default": "Aldrig" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Sammenligning",
      "blocks": [
        { "type": "row", "settings": { "feature": "Afgiver mikroplast i maden", "competitor_answer": "Risiko, især ved varme", "our_answer": "Aldrig" } },
        { "type": "row", "settings": { "feature": "BPA, ftalater, hormonstoffer", "competitor_answer": "Kan forekomme", "our_answer": "Helt fri" } },
        { "type": "row", "settings": { "feature": "Misfarvning og lugt", "competitor_answer": "Ja, med tiden", "our_answer": "Nej" } },
        { "type": "row", "settings": { "feature": "Levetid", "competitor_answer": "Måneder til få år", "our_answer": "Mange år" } },
        { "type": "row", "settings": { "feature": "Tåler opvaskemaskine", "competitor_answer": "Slides ned", "our_answer": "Ja, som ny" } }
      ]
    }
  ]
}
{% endschema %}
