{% comment %}
  Yummii Yummii — Quiz-SIDE (selvstændig, inline). Til dedikeret /pages/-side
  man sender trafik til. Uafhængig af yy-lp-quiz-popup (popup'en røres ikke).
  Fakta-drevet quiz (mikroplast/madpakke — IKKE Yummii-produkter), med familie-
  kontekst vævet ind (klassetrin) der styrer anbefalingen. Man spiller om en
  hemmelig gave. Stil: split (billede + indhold), grøn/creme, guld-badge.
  Flow: fakta-spørgsmål (scoret) + kontekst-spørgsmål (klassetrin) undervejs →
    nok rigtige → "Tillykke, du har vundet" → email → resultat;
    for få → tilbyd gaven alligevel → email → resultat.
  Selvstændig sektion. Én gang pr. session (localStorage). Kan åbnes af [data-qp-open].
  STUB: email → window-event "yy:quizLead" { email, answers, trin, won }.
{% endcomment %}

{{ 'yy-landing.css' | asset_url | stylesheet_tag }}

{%- assign qblocks = section.blocks | where: 'type', 'question' -%}
{%- assign tblocks = section.blocks | where: 'type', 'trin' -%}

{%- comment -%} Gave-variant: produkt-vælger vinder, ellers fast variant-id {%- endcomment -%}
{%- assign gift_variant = section.settings.gift_variant_id -%}
{%- if section.settings.gift_product != blank and section.settings.gift_product.selected_or_first_available_variant != blank -%}
  {%- assign gift_variant = section.settings.gift_product.selected_or_first_available_variant.id -%}
{%- endif -%}

{%- comment -%} Selvstændig quiz-SIDE (inline, altid åben). Uafhængig af popup-sektionen. {%- endcomment -%}
{%- assign is_page = true -%}

{% style %}
  .yy-qp-overlay{ position:fixed; inset:0; z-index:10000; display:none; align-items:center; justify-content:center; padding:22px; background:rgba(20,28,18,.55); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px);
    --qg:#3d7a4f; --qgd:#2d5a3a; --qgdeep:#243f2c; --qcream:#f4eedb; --qpaper:#fbf9f2; --qink:#1a1812; --qmuted:#8a8f88; --qgold:#e8b84b; --qgoldsoft:#ffd66b; --qline:#e6e2d4; }
  .yy-qp-overlay.is-open{ display:flex; animation:yyqp-fade .25s ease; }
  body.yy-qp-open{ overflow:hidden; }
  @keyframes yyqp-fade{ from{opacity:0} to{opacity:1} }
  @keyframes yyqp-pop{ from{opacity:0; transform:translateY(16px) scale(.97)} to{opacity:1; transform:none} }

  .yy-qp-pop{ position:relative; width:100%; max-width:820px; max-height:calc(100dvh - 44px); display:grid; grid-template-columns:44% 56%; background:var(--qpaper); color:var(--qink); border-radius:22px; overflow:hidden; box-shadow:0 40px 90px -30px rgba(0,0,0,.6); animation:yyqp-pop .32s cubic-bezier(.2,.8,.25,1); }
  .yy-qp-media{ position:relative; background:linear-gradient(160deg,#3d7a4f,#243f2c); background-size:cover; background-position:center; min-height:100%; overflow:hidden; }
  .yy-qp-media-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .yy-qp-media::after{ content:""; position:absolute; inset:0; z-index:1; background:linear-gradient(180deg, rgba(36,63,44,.15), rgba(36,63,44,.45)); }
  .yy-qp-badge, .yy-qp-media > .yy-qp-badge{ z-index:2; }
  .yy-qp-badge{ position:absolute; top:18px; left:18px; z-index:2; display:inline-flex; align-items:center; gap:6px; background:var(--qgoldsoft); color:var(--qgdeep); font-weight:700; font-size:13px; padding:7px 14px; border-radius:999px; }
  .yy-qp-close{ position:absolute; top:14px; right:14px; z-index:6; width:34px; height:34px; border-radius:50%; border:none; background:rgba(255,255,255,.9); color:var(--qink); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:.15s; }
  .yy-qp-close:hover{ background:#fff; transform:rotate(90deg); }
  .yy-qp-close svg{ width:16px; height:16px; }

  .yy-qp-body{ position:relative; min-height:0; overflow-y:auto; -webkit-overflow-scrolling:touch; padding:40px 40px 34px; }
  .yy-qp-bar{ position:absolute; top:0; left:0; right:0; height:5px; background:#e9e4d5; }
  .yy-qp-bar span{ display:block; height:100%; width:0; background:var(--qg); transition:width .3s ease; }

  .yy-qp-framing{ font-size:12px; letter-spacing:.02em; color:var(--qg); font-weight:700; margin:0 0 12px; display:inline-flex; align-items:center; gap:6px; }
  .yy-qp-eyebrow{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--qg); font-weight:700; margin:0 0 10px; }
  .yy-qp-h{ font-size:25px; line-height:1.12; letter-spacing:-.02em; font-weight:600; margin:0 0 10px; }
  .yy-qp-p{ color:#5a605a; font-size:14.5px; line-height:1.55; margin:0 0 18px; text-wrap:pretty; }
  .yy-qp-step{ display:none; }
  .yy-qp-step.is-active{ display:block; }
  .yy-qp-qnum{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-weight:700; color:var(--qmuted); margin:0 0 8px; }

  .yy-qp-opts{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
  .yy-qp-opt{ display:flex; align-items:center; gap:11px; text-align:left; min-height:60px; background:#fff; border:1.5px solid var(--qline); border-radius:14px; padding:11px 13px; font-size:14px; font-weight:600; line-height:1.25; cursor:pointer; transition:border-color .12s, background .12s; color:var(--qink); }
  .yy-qp-opt:hover{ border-color:var(--qg); }
  .yy-qp-letter{ flex:0 0 28px; width:28px; height:28px; border-radius:50%; background:var(--qgdeep); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; }
  .yy-qp-opt.is-correct{ border-color:var(--qg); background:#eaf3ec; }
  .yy-qp-opt.is-correct .yy-qp-letter{ background:var(--qg); }
  .yy-qp-opt.is-wrong{ border-color:#c9603f; background:#f7e9e3; }
  .yy-qp-opt.is-wrong .yy-qp-letter{ background:#c9603f; }
  .yy-qp-feedback{ font-size:13px; color:#5a605a; margin:12px 0 0; min-height:18px; }

  .yy-qp-input{ width:100%; font-family:inherit; font-size:15px; padding:14px 16px; border:1px solid var(--qline); border-radius:12px; background:#fff; color:var(--qink); outline:none; box-sizing:border-box; transition:.15s; }
  .yy-qp-input:focus{ border-color:var(--qg); box-shadow:0 0 0 3px rgba(61,122,79,.15); }
  .yy-qp-consent{ font-size:12px; color:var(--qmuted); margin:10px 0 14px; }

  .yy-qp-cta{ display:inline-flex; width:100%; align-items:center; justify-content:center; gap:8px; border:none; border-radius:12px; padding:15px 22px; font-family:inherit; font-size:15px; font-weight:600; cursor:pointer; background:var(--qg); color:var(--qcream); transition:.16s; text-decoration:none; margin-top:16px; }
  .yy-qp-cta:hover{ background:var(--qgd); transform:translateY(-1px); }
  .yy-qp-cta svg{ width:17px; height:17px; }
  .yy-qp-cta.is-added{ background:var(--qgdeep); pointer-events:none; }
  .yy-qp-cta.is-added:hover{ transform:none; }
  .yy-qp-cta--ghost{ background:transparent; color:var(--qg); border:1.5px solid var(--qg); margin-top:10px; }
  .yy-qp-cta--ghost:hover{ background:var(--qcream); color:var(--qgd); }
  .yy-qp-skip{ display:block; margin:12px auto 0; background:none; border:none; font-family:inherit; font-size:12.5px; color:var(--qmuted); text-decoration:underline; cursor:pointer; }
  .yy-qp-skip:hover{ color:var(--qink); }

  .yy-qp-trin{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .yy-qp-trin button{ background:#fff; border:1.5px solid var(--qline); border-radius:14px; padding:14px; font-family:inherit; font-weight:700; font-size:14px; color:var(--qink); cursor:pointer; transition:.12s; }
  .yy-qp-trin button:hover{ border-color:var(--qg); }

  .yy-qp-gift{ display:flex; gap:14px; align-items:center; background:var(--qcream); border:1px dashed var(--qg); border-radius:14px; padding:12px 14px; margin:0 0 14px; }
  .yy-qp-gift img{ width:52px; height:52px; object-fit:cover; border-radius:10px; }
  .yy-qp-gift-t{ font-weight:700; font-size:14px; color:var(--qgdeep); }
  .yy-qp-gift-s{ font-size:12.5px; color:#6f7a6c; }
  .yy-qp-rec{ display:flex; gap:14px; align-items:center; border:1px solid var(--qline); border-radius:14px; padding:12px 14px; margin:0 0 4px; background:#fff; }
  .yy-qp-rec img{ width:60px; height:60px; object-fit:cover; border-radius:10px; background:var(--qcream); }
  .yy-qp-rec-t{ font-weight:700; }
  .yy-qp-rec-p{ font-size:13.5px; color:#5a605a; }

  @media (max-width:720px){
    .yy-qp-overlay{ padding:0; align-items:flex-end; }
    .yy-qp-pop{ grid-template-columns:1fr; grid-template-rows:auto minmax(0,1fr); max-width:none; max-height:92dvh; border-radius:22px 22px 0 0; }
    .yy-qp-media{ min-height:120px; }
    .yy-qp-body{ padding:26px 22px 24px; }
    .yy-qp-h{ font-size:21px; }
    .yy-qp-opt{ min-height:54px; font-size:13.5px; padding:10px 12px; }
    .yy-qp-letter{ flex-basis:26px; width:26px; height:26px; }
  }

  /* ---- Side-tilstand: FULL-SCREEN oplevelse ---- */
  #shopify-section-{{ section.id }} .yy-qp-overlay--page{ position:static; inset:auto; z-index:auto; display:block; padding:0; background:{{ section.settings.page_bg_color | default: '#243f2c' }}; -webkit-backdrop-filter:none; backdrop-filter:none; }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page.is-open{ animation:none; }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-pop{ width:100%; max-width:none; min-height:100vh; min-height:100svh; max-height:none; border-radius:0; box-shadow:none; animation:none; grid-template-columns:{{ section.settings.page_media_width | default: 44 }}% auto; }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-media{ min-height:100vh; min-height:100svh; }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-media::after{ background:linear-gradient(180deg, rgba(36,63,44,.10), rgba(36,63,44,.72)); }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-body{ max-height:none; display:flex; flex-direction:column; justify-content:center; padding:56px 6vw; }
  #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-bar{ position:sticky; }
  #shopify-section-{{ section.id }} .yy-qp-herocap{ position:absolute; z-index:3; left:0; right:0; bottom:0; padding:44px 40px; color:#fff; }
  #shopify-section-{{ section.id }} .yy-qp-herocap h1{ font-size:clamp(30px,3.4vw,46px); line-height:1.05; letter-spacing:-.02em; font-weight:600; margin:0 0 12px; text-shadow:0 2px 30px rgba(0,0,0,.45); }
  #shopify-section-{{ section.id }} .yy-qp-herocap p{ font-size:16px; line-height:1.5; margin:0; opacity:.96; max-width:36ch; text-shadow:0 1px 22px rgba(0,0,0,.45); }
  @media (max-width:820px){
    #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-pop{ grid-template-columns:1fr; grid-template-rows:auto minmax(0,1fr); min-height:100svh; }
    #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-media{ min-height:40vh; }
    #shopify-section-{{ section.id }} .yy-qp-overlay--page .yy-qp-body{ padding:30px 22px 44px; justify-content:flex-start; }
    #shopify-section-{{ section.id }} .yy-qp-herocap{ padding:22px 22px 20px; }
    #shopify-section-{{ section.id }} .yy-qp-herocap h1{ font-size:26px; }
    #shopify-section-{{ section.id }} .yy-qp-herocap p{ font-size:14px; }
  }
{% endstyle %}

<div class="yy-qp-overlay{% if is_page %} yy-qp-overlay--page is-open{% endif %}" data-qp-overlay
  data-page="{% if is_page %}1{% else %}0{% endif %}"
  data-delay="{{ section.settings.delay | default: 4 }}"
  data-frequency="{{ section.settings.frequency_hours | default: 24 }}"
  data-win-min="{{ section.settings.win_min_correct | default: 2 }}"
  data-context-after="{{ section.settings.context_position | default: 2 }}"
  data-gift-variant="{{ gift_variant }}"
  data-klaviyo-site="{{ section.settings.klaviyo_site_id }}"
  data-klaviyo-list="{{ section.settings.klaviyo_list_id }}">
  <div class="yy-qp-pop" role="{% if is_page %}region{% else %}dialog{% endif %}"{% unless is_page %} aria-modal="true"{% endunless %} aria-label="{{ section.settings.quiz_heading | escape }}">
    {%- unless is_page -%}
    <button type="button" class="yy-qp-close" data-qp-close aria-label="Luk">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    {%- endunless -%}

    <div class="yy-qp-media">
      {%- if section.settings.media_image != blank -%}
        <img class="yy-qp-media-img"
          src="{{ section.settings.media_image | image_url: width: 800 }}"
          srcset="{{ section.settings.media_image | image_url: width: 400 }} 400w, {{ section.settings.media_image | image_url: width: 800 }} 800w, {{ section.settings.media_image | image_url: width: 1200 }} 1200w"
          sizes="(max-width:720px) 100vw, 400px"
          alt="" width="800" height="800" loading="eager" fetchpriority="low" decoding="async">
      {%- endif -%}
      {%- if section.settings.reward_badge != blank -%}<span class="yy-qp-badge">🎁 {{ section.settings.reward_badge }}</span>{%- endif -%}
      {%- if is_page and section.settings.page_heading != blank -%}
      <div class="yy-qp-herocap">
        <h1>{{ section.settings.page_heading }}</h1>
        {%- if section.settings.page_subtext != blank -%}<p>{{ section.settings.page_subtext }}</p>{%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="yy-qp-body">
      <div class="yy-qp-bar"><span data-qp-progress></span></div>
      {%- if section.settings.quiz_heading != blank -%}<p class="yy-qp-framing" data-qp-framing>🎁 {{ section.settings.quiz_heading }}</p>{%- endif -%}

      <!-- FAKTA-SPØRGSMÅL -->
      <div class="yy-qp-step is-active" data-qp-step="quiz">
        <p class="yy-qp-qnum" data-qp-step-label></p>
        <h2 class="yy-qp-h" data-qp-question></h2>
        <div class="yy-qp-opts" data-qp-opts></div>
        <p class="yy-qp-feedback" data-qp-feedback></p>
        <button type="button" class="yy-qp-cta" data-qp-next style="display:none">Videre
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>

      <!-- KONTEKST: familie / klassetrin (undervejs) -->
      <div class="yy-qp-step" data-qp-step="context">
        <h2 class="yy-qp-h">{{ section.settings.context_heading | default: 'Har du børn i skole — hvilket klassetrin?' }}</h2>
        <p class="yy-qp-p">{{ section.settings.context_text | default: 'Så finder vi det rigtige sæt til dig bagefter.' }}</p>
        <div class="yy-qp-trin">
          {%- for b in tblocks -%}
            <button type="button" data-qp-trin
              data-name="{{ b.settings.set_name | escape }}"
              data-price="{{ b.settings.set_price | escape }}"
              data-img="{% if b.settings.set_image != blank %}{{ b.settings.set_image | image_url: width: 200 }}{% endif %}"
              data-url="{{ b.settings.product_url }}"
              {{ b.shopify_attributes }}>{{ b.settings.label }}</button>
          {%- endfor -%}
        </div>
      </div>

      <!-- WIN -->
      <div class="yy-qp-step" data-qp-step="win">
        <p class="yy-qp-eyebrow">{{ section.settings.win_eyebrow | default: 'Tillykke' }}</p>
        <h2 class="yy-qp-h">{{ section.settings.win_heading | default: 'Du har vundet en hemmelig gave 🎁' }}</h2>
        <p class="yy-qp-p">{{ section.settings.win_text | default: 'Skriv din mail, så låser vi gaven op og viser dig det rigtige skole-sæt.' }}</p>
        <button type="button" class="yy-qp-cta" data-qp-to-email>{{ section.settings.win_button | default: 'Lås gaven op' }}</button>
      </div>

      <!-- LOSE -->
      <div class="yy-qp-step" data-qp-step="lose">
        <p class="yy-qp-eyebrow">{{ section.settings.lose_eyebrow | default: 'Så tæt på' }}</p>
        <h2 class="yy-qp-h">{{ section.settings.lose_heading | default: 'Du får gaven alligevel' }}</h2>
        <p class="yy-qp-p">{{ section.settings.lose_text | default: 'Ikke helt i mål på quizzen, men vi giver dig den hemmelige gave alligevel.' }}</p>
        <button type="button" class="yy-qp-cta" data-qp-to-email>{{ section.settings.lose_yes | default: 'Lås gaven op' }}</button>
        <button type="button" class="yy-qp-skip" data-qp-close>{{ section.settings.lose_no | default: 'Nej tak' }}</button>
      </div>

      <!-- EMAIL -->
      <div class="yy-qp-step" data-qp-step="email">
        <h2 class="yy-qp-h">{{ section.settings.email_heading | default: 'Hvor sender vi din gave hen?' }}</h2>
        <p class="yy-qp-p">{{ section.settings.email_text | default: 'Skriv din mail, så låser vi gaven op og viser dit resultat.' }}</p>
        <input type="text" class="yy-qp-input" data-qp-fname placeholder="{{ section.settings.fname_placeholder | default: 'Fornavn' }}" autocomplete="given-name" style="margin-bottom:10px">
        <input type="email" class="yy-qp-input" data-qp-email placeholder="{{ section.settings.email_placeholder | default: 'din@mail.dk' }}" autocomplete="email">
        <p class="yy-qp-consent">{{ section.settings.email_consent }}</p>
        <button type="button" class="yy-qp-cta" data-qp-email-submit>{{ section.settings.email_button | default: 'Se mit resultat' }}</button>
      </div>

      <!-- RESULT -->
      <div class="yy-qp-step" data-qp-step="result">
        <p class="yy-qp-eyebrow">{{ section.settings.result_eyebrow | default: 'Klar' }}</p>
        <h2 class="yy-qp-h">{{ section.settings.result_heading | default: 'Din gave er låst op' }}</h2>
        <div class="yy-qp-gift">
          {%- if section.settings.gift_image != blank -%}<img src="{{ section.settings.gift_image | image_url: width: 120 }}" alt="{{ section.settings.gift_title | escape }}" width="52" height="52">{%- endif -%}
          <div>
            <div class="yy-qp-gift-t">{{ section.settings.gift_title | default: 'Hemmelig gave 🎁' }}</div>
            <div class="yy-qp-gift-s">{{ section.settings.gift_note | default: 'Et sæt bivoks med i dit køb' }}</div>
          </div>
        </div>
        <button type="button" class="yy-qp-cta" data-qp-add-gift data-added-text="{{ section.settings.gift_added_text | default: 'Gaven er lagt i kurven ✓' | escape }}">{{ section.settings.gift_add_button | default: 'Læg gaven i kurven 🎁' }}</button>
        <p class="yy-qp-p" style="margin:16px 0 10px">{{ section.settings.result_text | default: 'Vi anbefaler dette skole-sæt til dig:' }}</p>
        <div class="yy-qp-rec">
          <img data-qp-rec-img alt="" width="60" height="60">
          <div>
            <div class="yy-qp-rec-t" data-qp-rec-name></div>
            <div class="yy-qp-rec-p" data-qp-rec-price></div>
          </div>
        </div>
        <a class="yy-qp-cta yy-qp-cta--ghost" data-qp-rec-cta href="#">{{ section.settings.result_cta | default: 'Se dit skole-sæt' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

    </div>
  </div>
</div>

<script type="application/json" data-qp-questions>
[
{%- for b in qblocks -%}
{"q": {{ b.settings.question | json }}, "a": [{{ b.settings.a1 | json }}, {{ b.settings.a2 | json }}, {{ b.settings.a3 | json }}, {{ b.settings.a4 | json }}], "correct": {{ b.settings.correct | default: 1 }}, "explain": {{ b.settings.explain | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
</script>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if(!root) return;
  var overlay = root.querySelector('[data-qp-overlay]');
  if(!overlay) return;
  var facts = [];
  try { facts = JSON.parse(root.querySelector('[data-qp-questions]').textContent); } catch(e){}
  var winMin = parseInt(overlay.getAttribute('data-win-min') || '2', 10);
  var ctxAfter = parseInt(overlay.getAttribute('data-context-after') || '2', 10);

  // Build sequence: fakta-spørgsmål med kontekst-spørgsmålet vævet ind.
  var seq = [];
  for (var i = 0; i < facts.length; i++){
    if (i === ctxAfter) seq.push({ type:'context' });
    seq.push({ type:'fact', q: facts[i] });
  }
  if (ctxAfter >= facts.length) seq.push({ type:'context' });
  var factTotal = facts.length;

  var seqIdx = 0, correctCount = 0, answers = [], lead = { email:'', firstName:'', answers:[], trin:'', won:false };
  var giftAdded = false;

  // Læg den hemmelige gave (0 kr produkt) i kurven — virker både på landingsside (yyCart) og forside (tema-kurv).
  function addGift(cb){
    var vid = overlay.getAttribute('data-gift-variant');
    if(!vid){ if(cb) cb(false); return; }
    if(giftAdded){ if(cb) cb(true); return; }
    giftAdded = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(vid), quantity: 1 }] })
    }).then(function(r){ return r.ok ? r.json() : null; })
      .then(function(data){
        if(!data){ giftAdded = false; if(cb) cb(false); return; }
        try { if (window.yyCart && typeof window.yyCart.refresh === 'function') window.yyCart.refresh(); } catch(e){}
        try { if (window.yyCart && typeof window.yyCart.open === 'function') window.yyCart.open(); } catch(e){}
        try { document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); } catch(e){}
        if(cb) cb(true);
      })
      .catch(function(){ giftAdded = false; if(cb) cb(false); });
  }

  // Klaviyo client-side subscribe (kræver Yummiis egen public Site-ID + liste-ID i sektionens indstillinger).
  function klaviyoSubscribe(email, fname){
    var site = overlay.getAttribute('data-klaviyo-site');
    var list = overlay.getAttribute('data-klaviyo-list');
    if(!site || !list) return;
    var attrs = { email: email };
    if (fname) attrs.first_name = fname;
    attrs.properties = { quiz_klassetrin: lead.trin || '', quiz_vundet: !!lead.won, kilde: 'Skolestart quiz' };
    try {
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(site), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
        body: JSON.stringify({
          data: {
            type: 'subscription',
            attributes: {
              custom_source: 'Skolestart quiz',
              profile: { data: { type: 'profile', attributes: attrs } }
            },
            relationships: { list: { data: { type: 'list', id: list } } }
          }
        })
      }).catch(function(){});
    } catch(e){}
  }

  function q(sel){ return overlay.querySelector(sel); }
  function show(step){
    overlay.querySelectorAll('[data-qp-step]').forEach(function(s){ s.classList.toggle('is-active', s.getAttribute('data-qp-step') === step); });
    var framing = q('[data-qp-framing]');
    if(framing) framing.style.display = (step === 'quiz' || step === 'context') ? '' : 'none';
    var pct = { quiz:35, context:55, win:70, lose:70, email:85, result:100 }[step] || 0;
    var bar = q('[data-qp-progress]'); if(bar) bar.style.width = pct + '%';
  }
  function open(){ overlay.classList.add('is-open'); document.body.classList.add('yy-qp-open'); start(); }
  function close(){ overlay.classList.remove('is-open'); document.body.classList.remove('yy-qp-open'); mark(); }
  function mark(){ try { localStorage.setItem('yy_qp_seen', String(Date.now())); } catch(e){} }
  function seenRecently(){
    try {
      var t = parseInt(localStorage.getItem('yy_qp_seen') || '0', 10);
      var hrs = parseFloat(overlay.getAttribute('data-frequency')) || 24;
      return t && (Date.now() - t) < hrs * 3600 * 1000;
    } catch(e){ return false; }
  }
  function start(){ seqIdx = 0; correctCount = 0; answers = []; renderNext(); }

  function renderNext(){
    var item = seq[seqIdx];
    if(!item){ evaluate(); return; }
    if(item.type === 'context'){ renderContext(); }
    else { renderFact(item.q); }
  }
  function evaluate(){
    var win = correctCount >= Math.min(winMin, factTotal);
    lead.won = win; lead.answers = answers;
    show(win ? 'win' : 'lose');
  }

  var factNum = 0;
  function renderFact(item){
    factNum = 0;
    for (var k = 0; k <= seqIdx; k++){ if(seq[k] && seq[k].type === 'fact') factNum++; }
    q('[data-qp-step-label]').textContent = 'Spørgsmål ' + factNum + ' af ' + factTotal;
    q('[data-qp-question]').textContent = item.q;
    q('[data-qp-feedback]').textContent = '';
    var next = q('[data-qp-next]'); next.style.display = 'none';
    var wrap = q('[data-qp-opts]'); wrap.innerHTML = ''; wrap.removeAttribute('data-locked');
    var opts = item.a.filter(function(x){ return x && String(x).trim(); });
    opts.forEach(function(ans, i){
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'yy-qp-opt';
      var letter = document.createElement('span');
      letter.className = 'yy-qp-letter';
      letter.textContent = String.fromCharCode(65 + i);
      var txt = document.createElement('span');
      txt.textContent = ans;
      b.appendChild(letter); b.appendChild(txt);
      b.addEventListener('click', function(){
        if(wrap.getAttribute('data-locked')) return;
        wrap.setAttribute('data-locked','1');
        var correct = (i + 1) === item.correct;
        if(correct) correctCount++;
        answers.push({ q:item.q, picked:ans, correct:correct });
        Array.prototype.forEach.call(wrap.children, function(c, ci){
          if((ci + 1) === item.correct) c.classList.add('is-correct');
          else if(ci === i) c.classList.add('is-wrong');
        });
        q('[data-qp-feedback]').textContent = (correct ? 'Rigtigt! ' : 'Ikke helt. ') + (item.explain || '');
        next.style.display = '';
      });
      wrap.appendChild(b);
    });
    show('quiz');
  }
  function renderContext(){ show('context'); }

  q('[data-qp-next]').addEventListener('click', function(){ seqIdx++; renderNext(); });

  overlay.querySelectorAll('[data-qp-trin]').forEach(function(btn){
    btn.addEventListener('click', function(){
      lead.trin = btn.textContent;
      q('[data-qp-rec-name]').textContent = btn.getAttribute('data-name') || '';
      q('[data-qp-rec-price]').textContent = btn.getAttribute('data-price') || '';
      var img = btn.getAttribute('data-img') || ''; var ri = q('[data-qp-rec-img]');
      if(img){ ri.src = img; ri.style.display = ''; } else { ri.style.display = 'none'; }
      q('[data-qp-rec-cta]').setAttribute('href', btn.getAttribute('data-url') || '#');
      seqIdx++; renderNext();
    });
  });

  overlay.querySelectorAll('[data-qp-to-email]').forEach(function(b){ b.addEventListener('click', function(){ show('email'); }); });

  q('[data-qp-email-submit]').addEventListener('click', function(){
    var input = q('[data-qp-email]');
    var fnameEl = q('[data-qp-fname]');
    var val = (input.value || '').trim();
    var fname = (fnameEl && fnameEl.value || '').trim();
    var okEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val);
    var okName = fname.length >= 1;
    if(fnameEl) fnameEl.style.borderColor = okName ? '' : '#c9603f';
    input.style.borderColor = okEmail ? '' : '#c9603f';
    if(!okEmail || !okName) return;
    lead.email = val; lead.firstName = fname;
    klaviyoSubscribe(val, fname);
    try { window.dispatchEvent(new CustomEvent('yy:quizLead', { detail: lead })); } catch(e){}
    show('result');
  });

  // Manuel CTA: brugeren lægger selv gaven i kurven (ikke automatisk).
  var addGiftBtn = q('[data-qp-add-gift]');
  if(addGiftBtn){
    var addGiftLabel = addGiftBtn.textContent;
    addGiftBtn.addEventListener('click', function(){
      if(giftAdded) return;
      addGiftBtn.disabled = true;
      addGiftBtn.textContent = '…';
      addGift(function(ok){
        if(ok){
          addGiftBtn.textContent = addGiftBtn.getAttribute('data-added-text') || 'Lagt i kurven ✓';
          addGiftBtn.classList.add('is-added');
        } else {
          addGiftBtn.disabled = false;
          addGiftBtn.textContent = addGiftLabel;
        }
      });
    });
  }

  var isPage = overlay.getAttribute('data-page') === '1';

  if(isPage){
    // Inline side-tilstand: quizzen kører direkte, ingen overlay/luk/auto.
    start();
  } else {
    overlay.querySelectorAll('[data-qp-close]').forEach(function(b){ b.addEventListener('click', close); });
    overlay.addEventListener('click', function(e){ if(e.target === overlay) close(); });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('is-open')) close(); });
    document.addEventListener('click', function(e){ if(e.target.closest('[data-qp-open]')){ e.preventDefault(); open(); } });

    {% if section.settings.enable_auto %}
    if(!seenRecently()){
      var delay = (parseFloat(overlay.getAttribute('data-delay')) || 4) * 1000;
      setTimeout(open, delay);
    }
    {% endif %}
  }
})();
</script>

