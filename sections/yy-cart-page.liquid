{% comment %}
  Yummii Yummii — Kurv-side (cart template section)
  Implementering af "Yummii Kurv-side"-designet på LIVE Shopify-kurvdata.
  - Linjevarer fra cart.items med FØR/EFTER-pris (compare_at) + "Spar"
  - Bundle-dropdown pr. linje (custom.bundle_includes) — som drawer-kurven
  - Fri-fragt-bar, ordreoversigt m. vejl. pris + "Du sparer"
  - Redigerbare betalingsikoner (indstilling)
  - Rigtig leveringsdato: hverdage, weekend springes over, kl.-cutoff
  - Mængde/fjern via /cart/change.js + Section Rendering API (ingen reload)
  Upload som sections/yy-cart-page.liquid, og vælg sektionen på Kurv-skabelonen.
{% endcomment %}

{%- assign threshold = section.settings.free_ship_threshold | default: 400 -%}
{%- assign threshold_cents = threshold | times: 100 -%}
{%- assign remain = threshold_cents | minus: cart.total_price -%}
{%- assign is_free = false -%}{%- if remain <= 0 -%}{%- assign is_free = true -%}{%- endif -%}
{%- assign pct = 0 -%}{%- if threshold_cents > 0 -%}{%- assign pct = cart.total_price | times: 100 | divided_by: threshold_cents -%}{%- endif -%}{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}

{%- comment -%} Beregn vejl. pris (compare_at) total for før/efter {%- endcomment -%}
{%- assign compare_total = 0 -%}
{%- for item in cart.items -%}
  {%- assign uw = item.variant.compare_at_price -%}
  {%- if uw == nil or uw < item.variant.price -%}{%- assign uw = item.variant.price -%}{%- endif -%}
  {%- assign line_cmp = uw | times: item.quantity -%}
  {%- assign compare_total = compare_total | plus: line_cmp -%}
{%- endfor -%}
{%- assign markdown_savings = compare_total | minus: cart.items_subtotal_price -%}
{%- assign total_savings = compare_total | minus: cart.total_price -%}
{%- capture remain_money -%}<strong>{{ remain | money }}</strong>{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }}{ --green:#3d7a4f; --green-dark:#2d5a3a; --green-deep:#243f2c; --cream:#f7f2e7; --cream-2:#efe9d8; --paper:#fbf9f2; --ink:#1a1812; --muted:#6b6657; --sale:#9c6b58; --gold:#e8b84b; --line:rgba(26,24,18,.08); --line-2:rgba(26,24,18,.12); }
  .yy-cartp{ font-family:'DM Sans',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--ink); background:{{ section.settings.bg_color | default: '#fbf9f2' }}; -webkit-font-smoothing:antialiased; line-height:1.5; overflow-x:hidden; width:100%; max-width:100%; }
  .yy-cartp *{ box-sizing:border-box; }
  .yy-cartp img{ display:block; max-width:100%; }
  .yy-cartp button{ font-family:inherit; cursor:pointer; }
  .yy-cartp a{ color:var(--green); text-decoration:none; }
  .yy-cartp a:hover{ color:var(--green-dark); }
  .yy-cartp .wrap{ max-width:1180px; margin:0 auto; padding:34px 24px 90px; }
  .yy-cartp .crumbs{ font-size:13px; color:var(--muted); margin-bottom:18px; }
  .yy-cartp .crumbs a{ color:var(--muted); }
  .yy-cartp .phead{ display:flex; align-items:baseline; gap:12px; margin-bottom:6px; }
  .yy-cartp .phead h1{ font-size:clamp(26px,4vw,34px); font-weight:600; letter-spacing:-.03em; }
  .yy-cartp .phead .cnt{ font-size:16px; color:var(--muted); font-weight:500; }
  .yy-cartp .psub{ color:var(--muted); font-size:14.5px; margin-bottom:26px; }
  .yy-cartp .layout{ display:grid; grid-template-columns:1fr 380px; gap:40px; align-items:start; }
  .yy-cartp .col-main{ grid-column:1; grid-row:1; min-width:0; }
  .yy-cartp .xsell{ grid-column:1; grid-row:2; min-width:0; }
  .yy-cartp .items{ min-width:0; }
  .yy-cartp .item__info{ min-width:0; }
  .yy-cartp .xcard{ min-width:0; }
  .yy-cartp .ship{ background:#fff; border:1px solid var(--line); border-radius:16px; padding:16px 20px; margin-bottom:20px; }
  .yy-cartp .ship__row{ display:flex; align-items:center; gap:9px; font-size:{{ section.settings.ship_text_size | default: 13 }}px; line-height:1.25; margin-bottom:11px; }
  .yy-cartp .ship__row svg{ width:18px; height:18px; color:var(--green); flex-shrink:0; }
  .yy-cartp .ship__row strong{ font-weight:700; }
  .yy-cartp .ship__bar{ height:8px; border-radius:999px; background:rgba(26,24,18,.09); overflow:hidden; }
  .yy-cartp .ship__fill{ display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#6fae7e,#3d7a4f); transition:width .45s cubic-bezier(.4,0,.2,1); }
  .yy-cartp .ship.is-free .ship__fill{ background:var(--green); }
  .yy-cartp .ship.is-free .ship__row{ color:var(--green); font-weight:600; }
  .yy-cartp .items{ background:#fff; border:1px solid var(--line); border-radius:16px; overflow:hidden; }
  .yy-cartp .item{ display:grid; grid-template-columns:104px 1fr auto; gap:18px; padding:20px; border-bottom:1px solid var(--line); }
  .yy-cartp .item:last-child{ border-bottom:none; }
  .yy-cartp .item__media{ position:relative; border-radius:12px; overflow:hidden; aspect-ratio:1/1; background:var(--cream-2); }
  .yy-cartp .item__media img{ width:100%; height:100%; object-fit:cover; }
  .yy-cartp .item__badge{ position:absolute; top:7px; left:7px; background:var(--sale); color:#fff; font-size:10px; font-weight:700; padding:3px 7px; border-radius:6px; }
  .yy-cartp .item__info{ display:flex; flex-direction:column; min-width:0; }
  .yy-cartp .item__mat{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); font-weight:600; }
  .yy-cartp .item__name{ font-size:17px; font-weight:600; letter-spacing:-.01em; margin:3px 0 4px; }
  .yy-cartp .item__name a{ color:inherit; }
  .yy-cartp .item__variant{ font-size:13px; color:var(--muted); }
  .yy-cartp .item__bundle{ margin-top:9px; }
  .yy-cartp .item__bundle summary{ list-style:none; cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; color:var(--green); }
  .yy-cartp .item__bundle summary::-webkit-details-marker{ display:none; }
  .yy-cartp .item__bundle summary svg{ width:13px; height:13px; transition:transform .2s; }
  .yy-cartp .item__bundle[open] summary svg{ transform:rotate(180deg); }
  .yy-cartp .item__bundle ul{ list-style:none; margin:10px 0 2px; padding:11px 13px; display:flex; flex-direction:column; gap:9px; background:var(--paper); border:1px solid var(--line); border-radius:11px; }
  .yy-cartp .item__bundle li{ display:flex; align-items:center; gap:10px; font-size:12.5px; }
  .yy-cartp .item__bundle .bthumb{ width:36px; height:36px; border-radius:7px; background:var(--cream-2) center/cover; flex:0 0 36px; }
  .yy-cartp .item__bundle .bname{ flex:1; min-width:0; color:var(--ink); font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .yy-cartp .item__bundle .bprice{ color:var(--muted); font-weight:600; margin-left:auto; white-space:nowrap; }
  .yy-cartp .item__stock{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; color:var(--muted); margin-top:9px; }
  .yy-cartp .item__stock::before{ content:""; width:8px; height:8px; border-radius:50%; background:#4caf50; }
  .yy-cartp .item__controls{ display:flex; align-items:center; gap:16px; margin-top:auto; padding-top:14px; }
  .yy-cartp .stepper{ display:inline-flex; align-items:center; gap:4px; background:rgba(26,24,18,.05); border-radius:999px; padding:4px; }
  .yy-cartp .stepper button{ width:32px; height:32px; border-radius:50%; border:none; background:#fff; color:var(--ink); font-size:18px; line-height:1; display:grid; place-items:center; box-shadow:0 1px 3px rgba(26,24,18,.1); }
  .yy-cartp .stepper button:hover{ color:var(--green); }
  .yy-cartp .stepper .val{ min-width:28px; text-align:center; font-size:14px; font-weight:600; }
  .yy-cartp .item__remove{ background:none; border:none; color:var(--muted); font-size:13px; font-weight:500; display:inline-flex; align-items:center; gap:6px; padding:4px; }
  .yy-cartp .item__remove svg{ width:16px; height:16px; }
  .yy-cartp .item__remove:hover{ color:var(--sale); }
  .yy-cartp .item__pricing{ text-align:right; display:flex; flex-direction:column; align-items:flex-end; gap:3px; }
  .yy-cartp .item__now{ font-size:18px; font-weight:700; white-space:nowrap; }
  .yy-cartp .item__now.is-sale{ color:var(--sale); }
  .yy-cartp .item__was{ font-size:13px; color:#9a9484; text-decoration:line-through; white-space:nowrap; }
  .yy-cartp .item__spar{ font-size:11.5px; font-weight:700; color:var(--green); white-space:nowrap; }
  .yy-cartp .item__each{ font-size:12px; color:var(--muted); }
  .yy-cartp .xsell{ margin-top:0; }
  .yy-cartp .xsell__h{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .yy-cartp .xsell__h h2{ font-size:18px; font-weight:600; letter-spacing:-.01em; }
  .yy-cartp .xsell__h span{ font-size:13px; color:var(--muted); }
  .yy-cartp .xsell__grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .yy-cartp .xcard{ background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px; display:flex; flex-direction:column; }
  .yy-cartp .xcard__media{ border-radius:10px; overflow:hidden; aspect-ratio:1/1; background:var(--cream-2); margin-bottom:10px; }
  .yy-cartp .xcard__media img{ width:100%; height:100%; object-fit:cover; }
  .yy-cartp .xcard__name{ font-size:14px; font-weight:600; line-height:1.25; }
  .yy-cartp .xcard__sub{ font-size:12px; color:var(--muted); margin-top:2px; }
  .yy-cartp .xcard__row{ display:flex; align-items:center; justify-content:space-between; margin-top:auto; padding-top:10px; }
  .yy-cartp .xcard__price{ font-size:14px; font-weight:700; }
  .yy-cartp .xcard__add{ background:var(--ink); color:#fff; border:none; border-radius:999px; padding:8px 15px; font-size:12.5px; font-weight:600; display:inline-flex; align-items:center; gap:6px; transition:.15s; }
  .yy-cartp .xcard__add:hover{ background:var(--green); }
  .yy-cartp .xcard__add svg{ width:14px; height:14px; }
  .yy-cartp .xcard__add[disabled]{ opacity:.7; }
  .yy-cartp .summary{ grid-column:2; grid-row:1 / span 2; position:sticky; top:24px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:24px; }
  .yy-cartp .summary h2{ font-size:18px; font-weight:600; letter-spacing:-.01em; margin-bottom:18px; }
  .yy-cartp .sumline{ display:flex; justify-content:space-between; align-items:baseline; font-size:14.5px; margin-bottom:11px; color:var(--ink); }
  .yy-cartp .sumline.muted{ color:var(--muted); font-size:13.5px; }
  .yy-cartp .sumline.disc{ color:var(--green); font-weight:600; }
  .yy-cartp .sumline .strike{ text-decoration:line-through; color:#9a9484; }
  .yy-cartp .sumline .free{ color:var(--green); font-weight:600; }
  .yy-cartp .promo{ display:flex; gap:8px; margin:16px 0; }
  .yy-cartp .promo input{ flex:1; min-width:0; font-family:inherit; font-size:13.5px; padding:11px 13px; border:1px solid var(--line-2); border-radius:10px; background:var(--paper); outline:none; }
  .yy-cartp .promo input:focus{ border-color:var(--green); box-shadow:0 0 0 3px rgba(61,122,79,.14); }
  .yy-cartp .promo button{ background:var(--cream-2); border:1px solid var(--line-2); border-radius:10px; padding:0 16px; font-size:13.5px; font-weight:600; color:var(--ink); }
  .yy-cartp .promo button:hover{ background:var(--cream); }
  .yy-cartp .sumtotal{ display:flex; justify-content:space-between; align-items:baseline; padding-top:16px; margin-top:5px; border-top:1px solid var(--line); font-size:17px; font-weight:700; }
  .yy-cartp .sumtotal .totwrap{ display:flex; align-items:baseline; gap:9px; }
  .yy-cartp .sumtotal .big{ font-size:24px; letter-spacing:-.02em; }
  .yy-cartp .sumtotal .was{ font-size:15px; font-weight:600; color:#9a9484; text-decoration:line-through; }
  .yy-cartp .spartag{ display:inline-flex; align-items:center; gap:5px; background:#eef3e6; color:var(--green-deep); font-size:12px; font-weight:700; padding:4px 9px; border-radius:7px; margin-top:8px; }
  .yy-cartp .spartag svg{ width:13px; height:13px; }
  .yy-cartp .deliv{ display:flex; align-items:flex-start; gap:11px; background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:12px 14px; margin-top:14px; }
  .yy-cartp .deliv svg{ width:20px; height:20px; color:var(--green); flex-shrink:0; margin-top:2px; }
  .yy-cartp .deliv .l{ font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); font-weight:600; }
  .yy-cartp .deliv .v{ font-size:14px; font-weight:600; line-height:1.3; }
  .yy-cartp .deliv .note{ font-size:11.5px; color:var(--green); font-weight:600; margin-top:3px; }
  .yy-cartp .checkout{ width:100%; background:var(--green); color:#fff; border:none; border-radius:999px; height:56px; font-size:15.5px; font-weight:700; letter-spacing:.02em; display:inline-flex; align-items:center; justify-content:center; gap:10px; margin-top:16px; transition:.15s; }
  .yy-cartp .checkout:hover{ background:var(--green-dark); transform:translateY(-1px); }
  .yy-cartp .checkout svg{ width:18px; height:18px; }
  .yy-cartp .contlink{ display:block; text-align:center; font-size:13.5px; color:var(--muted); margin-top:13px; font-weight:500; }
  .yy-cartp .contlink:hover{ color:var(--ink); }
  .yy-cartp .pay{ display:flex; flex-wrap:nowrap; gap:5px; justify-content:center; margin-top:18px; }
  .yy-cartp .pay span{ flex:1 1 0; min-width:0; min-height:30px; padding:4px 6px; border:1px solid var(--line-2); border-radius:6px; background:#fff; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:800; font-family:system-ui,sans-serif; color:var(--ink); white-space:nowrap; overflow:hidden; }
  .yy-cartp .pay span img{ max-width:100%; max-height:{{ section.settings.pay_icon_height | default: 24 }}px; width:auto; height:auto; object-fit:contain; display:block; }
  .yy-cartp .trust{ display:flex; flex-direction:column; gap:10px; margin-top:18px; padding-top:18px; border-top:1px solid var(--line); }
  .yy-cartp .trust-item{ display:flex; align-items:center; gap:10px; font-size:13px; color:var(--muted); }
  .yy-cartp .trust-item svg{ width:17px; height:17px; color:var(--green); flex-shrink:0; }
  .yy-cartp .trust-item strong{ color:var(--ink); font-weight:600; }
  .yy-cartp .trust-item--tp{ flex-wrap:wrap; }
  .yy-cartp .tp-stars{ display:inline-flex; gap:2px; flex-shrink:0; }
  .yy-cartp .tp-star{ width:17px; height:17px; border-radius:2px; background:#00b67a; display:inline-flex; align-items:center; justify-content:center; }
  .yy-cartp .tp-star svg{ width:11px; height:11px; color:#fff; }
  .yy-cartp .empty{ text-align:center; padding:70px 24px; background:#fff; border:1px solid var(--line); border-radius:16px; }
  .yy-cartp .empty .ic{ width:76px; height:76px; border-radius:50%; background:var(--cream-2); display:flex; align-items:center; justify-content:center; color:var(--green); margin:0 auto 20px; }
  .yy-cartp .empty .ic svg{ width:36px; height:36px; }
  .yy-cartp .empty h2{ font-size:22px; font-weight:600; margin-bottom:8px; }
  .yy-cartp .empty p{ color:var(--muted); margin-bottom:24px; }
  .yy-cartp .empty .cta{ display:inline-flex; background:var(--green); color:#fff; padding:14px 28px; border-radius:999px; font-weight:600; font-size:15px; }
  .yy-cartp .empty .cta:hover{ background:var(--green-dark); color:#fff; }
  .yy-cartp.is-busy{ opacity:.6; pointer-events:none; }
  @media(max-width:900px){
    .yy-cartp .layout{ grid-template-columns:1fr; gap:26px; }
    .yy-cartp .col-main, .yy-cartp .summary, .yy-cartp .xsell{ grid-column:auto; grid-row:auto; }
    .yy-cartp .summary{ position:static; }
    .yy-cartp .xsell__grid{ grid-template-columns:1fr 1fr; }
  }
  @media(max-width:680px){
    .yy-cartp .wrap{ padding:24px 16px 60px; }
    .yy-cartp .phead h1{ font-size:23px; }
    .yy-cartp .psub{ font-size:13.5px; margin-bottom:20px; }
    /* Linjevare: billede til venstre (spænder), info + pris under hinanden til højre */
    .yy-cartp .item{ grid-template-columns:64px 1fr; gap:13px; padding:15px; }
    .yy-cartp .item__media{ grid-column:1; grid-row:1 / span 2; align-self:start; }
    .yy-cartp .item__info{ grid-column:2; grid-row:1; }
    .yy-cartp .item__badge{ font-size:9px; padding:2px 5px; top:5px; left:5px; }
    .yy-cartp .item__name{ font-size:14.5px; line-height:1.3; margin:2px 0 3px; }
    .yy-cartp .item__mat{ font-size:10px; }
    .yy-cartp .item__pricing{ grid-column:2; grid-row:2; text-align:left; flex-direction:row; flex-wrap:wrap; align-items:baseline; gap:4px 9px; justify-content:flex-start; margin-top:11px; }
    .yy-cartp .item__now{ font-size:16px; }
    .yy-cartp .item__was{ font-size:12.5px; }
    .yy-cartp .item__spar{ font-size:11px; }
    .yy-cartp .item__each{ display:none; }
    .yy-cartp .item__controls{ flex-wrap:wrap; gap:12px; padding-top:12px; }
    .yy-cartp .xsell__h h2{ font-size:16px; }
    /* Cross-sell = vandret scroll-galleri på mobil */
    .yy-cartp .xsell__grid{ display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; padding-bottom:8px; scrollbar-width:none; }
    .yy-cartp .xsell__grid::-webkit-scrollbar{ display:none; }
    .yy-cartp .xcard{ flex:0 0 62%; max-width:230px; scroll-snap-align:start; padding:10px; }
    .yy-cartp .xcard__name{ font-size:13px; }
    .yy-cartp .xcard__sub{ font-size:11px; }
    .yy-cartp .xcard__row{ flex-wrap:wrap; gap:8px; }
    .yy-cartp .xcard__price{ font-size:13.5px; }
    .yy-cartp .xcard__add{ padding:7px 12px; font-size:12px; }
    .yy-cartp .summary{ padding:20px; }
    .yy-cartp .summary h2{ font-size:16px; }
    .yy-cartp .checkout{ height:52px; font-size:15px; }
  }
  @media(max-width:420px){
    .yy-cartp .xcard{ flex-basis:72%; }
    .yy-cartp .item__controls .item__remove{ margin-left:0; }
  }
{% endstyle %}

<div class="yy-cartp" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="crumbs"><a href="{{ routes.root_url }}">Forside</a> / <a href="{{ routes.all_products_collection_url }}">Alle produkter</a> / Kurv</div>
    <div class="phead"><h1>{{ section.settings.heading | default: 'Din kurv' }}</h1><span class="cnt">{{ cart.item_count }} {% if cart.item_count == 1 %}vare{% else %}varer{% endif %}</span></div>
    <p class="psub">{{ section.settings.subtext | default: 'Fri ombytning i 30 dage. Sikker betaling og hurtig levering.' }}</p>

    {%- if cart.item_count > 0 -%}
      {%- if section.settings.free_ship_threshold > 0 -%}
      <div class="ship{% if is_free %} is-free{% endif %}">
        <div class="ship__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
          <span>{% if is_free %}{{ section.settings.ship_free_text | default: 'Tillykke! Du har fri fragt på denne ordre 🎉' }}{% else %}{{ section.settings.ship_progress_text | default: 'Køb for [beløb] mere og få fri fragt' | replace: '[beløb]', remain_money }}{% endif %}</span>
        </div>
        <div class="ship__bar"><span class="ship__fill" style="width:{{ pct }}%"></span></div>
      </div>
      {%- endif -%}

      <div class="layout">
        <div class="col-main">
          <div class="items">
            {%- for item in cart.items -%}
              {%- assign unit_was = item.variant.compare_at_price -%}
              {%- assign has_was = false -%}
              {%- if unit_was and unit_was > item.variant.price -%}{%- assign has_was = true -%}{%- endif -%}
              {%- assign line_was = 0 -%}{%- assign line_spar = 0 -%}
              {%- if has_was -%}
                {%- assign line_was = unit_was | times: item.quantity -%}
                {%- assign line_spar = line_was | minus: item.final_line_price -%}
              {%- endif -%}
              {%- assign includes = item.product.metafields.custom.bundle_includes.value -%}
              <div class="item" data-key="{{ item.key }}">
                <div class="item__media">
                  {%- if has_was -%}
                    {%- assign off = unit_was | minus: item.variant.price | times: 100 | divided_by: unit_was -%}
                    <span class="item__badge">-{{ off }}%</span>
                  {%- endif -%}
                  {%- if item.image -%}<a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.title | escape }}" width="104" height="104" loading="lazy"></a>{%- endif -%}
                </div>
                <div class="item__info">
                  {%- if item.product.type != blank -%}<span class="item__mat">{{ item.product.type }}</span>{%- endif -%}
                  <span class="item__name"><a href="{{ item.url }}">{{ item.product.title }}</a></span>
                  {%- unless item.variant.title contains 'Default' -%}<span class="item__variant">{{ item.variant.title }}</span>{%- endunless -%}
                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    {%- for alloc in item.line_level_discount_allocations -%}<span class="item__variant" style="color:var(--green)">{{ alloc.discount_application.title }} (−{{ alloc.amount | money }})</span>{%- endfor -%}
                  {%- endif -%}
                  {%- if includes != blank and includes.size > 0 -%}
                    <details class="item__bundle">
                      <summary>{{ section.settings.bundle_toggle_text | default: 'Se hvad der er inkluderet' }} ({{ includes.size }} dele) <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
                      <ul>
                        {%- for p in includes -%}
                          {%- assign pv = p.selected_or_first_available_variant -%}
                          <li>
                            <span class="bthumb"{%- if p.featured_image %} style="background-image:url('{{ p.featured_image | image_url: width: 80 }}')"{% endif %}></span>
                            <a class="bname" href="{{ p.url }}">{{ p.title }}</a>
                            <span class="bprice">{{ pv.price | money }}</span>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- endif -%}
                  <span class="item__stock">{{ section.settings.stock_text | default: 'På lager · klar til afsendelse' }}</span>
                  <div class="item__controls">
                    <div class="stepper" role="group">
                      <button type="button" data-step="-1" aria-label="Færre">−</button>
                      <span class="val">{{ item.quantity }}</span>
                      <button type="button" data-step="1" aria-label="Flere">+</button>
                    </div>
                    <button type="button" class="item__remove" data-remove><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 13h10l1-13"/></svg>Fjern</button>
                  </div>
                </div>
                <div class="item__pricing">
                  <span class="item__now{% if has_was %} is-sale{% endif %}">{{ item.final_line_price | money }}</span>
                  {%- if has_was -%}<span class="item__was">{{ line_was | money }}</span><span class="item__spar">Spar {{ line_spar | money }}</span>{%- endif -%}
                  {%- if item.quantity > 1 -%}<span class="item__each">{{ item.final_price | money }} / stk</span>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} Cross-sell: 1) produkternes egne custom.crosssell_products, 2) fallback = kollektion {%- endcomment -%}
          {%- assign xsell_max = 3 -%}
          {%- assign shown = 0 -%}
          {%- assign seen = ',' -%}
          {%- for ci in cart.items -%}{%- assign seen = seen | append: ci.product_id | append: ',' -%}{%- endfor -%}
          {%- capture xsell_cards -%}
            {%- for ci in cart.items -%}
              {%- if shown >= xsell_max -%}{%- break -%}{%- endif -%}
              {%- assign rec = ci.product.metafields.custom.crosssell_products.value -%}
              {%- if rec != blank and rec.size > 0 -%}
                {%- for p in rec -%}
                  {%- if shown >= xsell_max -%}{%- break -%}{%- endif -%}
                  {%- assign idkey = ',' | append: p.id | append: ',' -%}
                  {%- unless seen contains idkey -%}
                    {%- assign seen = seen | append: p.id | append: ',' -%}
                    {%- assign shown = shown | plus: 1 -%}
                    {%- assign pv = p.selected_or_first_available_variant -%}
                    <div class="xcard">
                      <a class="xcard__media" href="{{ p.url }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">{%- endif -%}</a>
                      <div class="xcard__name">{{ p.title }}</div>
                      {%- if p.type != blank -%}<div class="xcard__sub">{{ p.type }}</div>{%- endif -%}
                      <div class="xcard__row">
                        <span class="xcard__price">{{ pv.price | money }}</span>
                        <button type="button" class="xcard__add" data-add="{{ pv.id }}"{% unless pv.available %} disabled{% endunless %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Tilføj</button>
                      </div>
                    </div>
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if shown < xsell_max and section.settings.crosssell_collection != blank -%}
              {%- assign xcol = collections[section.settings.crosssell_collection] -%}
              {%- for p in xcol.products -%}
                {%- if shown >= xsell_max -%}{%- break -%}{%- endif -%}
                {%- assign idkey = ',' | append: p.id | append: ',' -%}
                {%- unless seen contains idkey -%}
                  {%- assign seen = seen | append: p.id | append: ',' -%}
                  {%- assign shown = shown | plus: 1 -%}
                  {%- assign pv = p.selected_or_first_available_variant -%}
                  <div class="xcard">
                    <a class="xcard__media" href="{{ p.url }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy">{%- endif -%}</a>
                    <div class="xcard__name">{{ p.title }}</div>
                    {%- if p.type != blank -%}<div class="xcard__sub">{{ p.type }}</div>{%- endif -%}
                    <div class="xcard__row">
                      <span class="xcard__price">{{ pv.price | money }}</span>
                      <button type="button" class="xcard__add" data-add="{{ pv.id }}"{% unless pv.available %} disabled{% endunless %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Tilføj</button>
                    </div>
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- assign xsell_cards = xsell_cards | strip -%}
        </div>

        <aside class="summary">
          <h2>{{ section.settings.summary_heading | default: 'Ordreoversigt' }}</h2>
          <div class="sumline"><span>{{ section.settings.label_subtotal | default: 'Subtotal' }}</span><strong>{{ cart.items_subtotal_price | money }}</strong></div>
          {%- for disc in cart.cart_level_discount_applications -%}
            <div class="sumline disc"><span>{{ disc.title }}</span><span>−{{ disc.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="sumline muted"><span>{{ section.settings.label_shipping | default: 'Fragt' }}</span><span class="{% if is_free %}free{% endif %}">{% if is_free %}{{ section.settings.shipping_free_text | default: 'Gratis' }}{% else %}{{ section.settings.shipping_calc_text | default: 'Beregnes ved kassen' }}{% endif %}</span></div>
          {%- if section.settings.show_promo -%}
          <form class="promo" data-promo>
            <input type="text" name="discount" placeholder="{{ section.settings.promo_placeholder | default: 'Rabatkode' | escape }}" autocomplete="off">
            <button type="submit">{{ section.settings.promo_button | default: 'Anvend' }}</button>
          </form>
          {%- endif -%}
          <div class="sumtotal"><span>{{ section.settings.label_total | default: 'Total' }}</span><div class="totwrap">{%- if total_savings > 0 -%}<span class="was">{{ compare_total | money }}</span>{%- endif -%}<span class="big">{{ cart.total_price | money }}</span></div></div>
          {%- if total_savings > 0 -%}<div class="spartag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1 0-4h12v4"/><path d="M4 6v12a2 2 0 0 0 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg><span>{{ section.settings.savings_label | default: 'Du sparer' }} {{ total_savings | money }}</span></div>{%- endif -%}
          {%- if section.settings.show_delivery -%}
          <div class="deliv" data-deliv data-min="{{ section.settings.delivery_min_days | default: 1 }}" data-max="{{ section.settings.delivery_max_days | default: 3 }}" data-cutoff="{{ section.settings.cutoff_hour | default: 12 }}" data-note="{{ section.settings.delivery_cutoff_text | default: 'Bestil inden kl. [kl] i dag → sendes i dag' | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
            <div>
              <div class="l">{{ section.settings.delivery_label | default: 'Forventet levering' }}</div>
              <div class="v"><span data-deliv-range>{{ section.settings.delivery_min_days | default: 1 }}-{{ section.settings.delivery_max_days | default: 3 }} hverdage</span></div>
              <div class="note" data-deliv-note style="display:none"></div>
            </div>
          </div>
          {%- endif -%}
          <button type="button" class="checkout" data-checkout>{{ section.settings.checkout_text | default: 'Gå til kassen' }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          <a href="{{ routes.all_products_collection_url }}" class="contlink">{{ section.settings.continue_text | default: '← Fortsæt med at shoppe' }}</a>
          {%- if section.settings.show_payment_icons -%}
            {%- assign pay_blocks = section.blocks | where: 'type', 'payment' -%}
            {%- if pay_blocks.size > 0 -%}
            <div class="pay">
              {%- for b in pay_blocks -%}
                <span {{ b.shopify_attributes }}>{%- if b.settings.image != blank -%}<img src="{{ b.settings.image | image_url: width: 160 }}" alt="{{ b.settings.label | escape }}" loading="lazy">{%- else -%}{{ b.settings.label | default: '' | strip | replace: ' ', '&nbsp;' }}{%- endif -%}</span>
              {%- endfor -%}
            </div>
            {%- elsif section.settings.payment_icons != blank -%}
            <div class="pay">{%- assign icons = section.settings.payment_icons | split: ',' -%}{%- for ic in icons -%}<span>{{ ic | strip | replace: ' ', '&nbsp;' }}</span>{%- endfor -%}</div>
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.show_trust -%}
          <div class="trust">
            {%- if section.settings.trust_return != blank -%}<div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>{{ section.settings.trust_return | default: 'Fri ombytning i 30 dage' }}</span></div>{%- endif -%}
            {%- if section.settings.trust_delivery != blank -%}<div class="trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg><span>{{ section.settings.trust_delivery | default: 'Levering' }} <strong data-deliv-trust>{{ section.settings.delivery_min_days | default: 1 }}-{{ section.settings.delivery_max_days | default: 3 }} hverdage</strong></span></div>{%- endif -%}
            {%- if section.settings.show_trustpilot -%}
            <div class="trust-item trust-item--tp">
              <span class="tp-stars" role="img" aria-label="Trustpilot 5 ud af 5 stjerner">
                {%- for i in (1..5) -%}<span class="tp-star"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 18.6 5.8 21.2l1.6-7L2 9.5l7.1-.6z"/></svg></span>{%- endfor -%}
              </span>
              <span>{{ section.settings.trust_rating | default: '4,5/5 · +45.000 anmeldelser' }}</span>
            </div>
            {%- endif -%}
          </div>
          {%- endif -%}
        </aside>

        {%- if xsell_cards != blank -%}
          <div class="xsell">
            <div class="xsell__h"><h2>{{ section.settings.crosssell_heading | default: 'Glem ikke tilbehøret' }}</h2><span>{{ section.settings.crosssell_subtitle | default: 'Passer til din kurv' }}</span></div>
            <div class="xsell__grid">{{ xsell_cards }}</div>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      <div class="empty">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg></div>
        <h2>Din kurv er tom</h2>
        <p>Find en madkasse, der holder i årevis.</p>
        <a href="{{ routes.all_products_collection_url }}" class="cta">Shop madkasser</a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var host = document.getElementById('shopify-section-{{ section.id }}');
  if(!host) return;
  var sectionId = '{{ section.id }}';
  var busy = false;

  function setBusy(b){ busy = b; var r = host.querySelector('.yy-cartp'); if(r) r.classList.toggle('is-busy', b); }

  var WD = ['søn','man','tir','ons','tor','fre','lør'];
  var MO = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];
  function fmt(d){ return WD[d.getDay()]+'. '+d.getDate()+'. '+MO[d.getMonth()]; }
  function addBiz(date, n){ var d = new Date(date.getTime()); var a = 0; while(a < n){ d.setDate(d.getDate()+1); var w = d.getDay(); if(w !== 0 && w !== 6) a++; } return d; }
  function fillDelivery(){
    var el = host.querySelector('[data-deliv]'); if(!el) return;
    var min = parseInt(el.getAttribute('data-min'),10) || 1;
    var max = parseInt(el.getAttribute('data-max'),10) || 3;
    var cut = parseInt(el.getAttribute('data-cutoff'),10) || 12;
    var now = new Date();
    var ship = new Date(now.getTime());
    var w = now.getDay();
    var weekend = (w === 0 || w === 6);
    var before = now.getHours() < cut;
    if(weekend || !before){ ship = addBiz(ship, 1); }
    var e = addBiz(ship, min), l = addBiz(ship, max);
    var range = 'ml. ' + fmt(e) + ' – ' + fmt(l);
    var rEl = el.querySelector('[data-deliv-range]'); if(rEl) rEl.textContent = range;
    var note = el.querySelector('[data-deliv-note]');
    if(note){
      if(!weekend && before){
        var tpl = el.getAttribute('data-note') || 'Bestil inden kl. [kl] i dag → sendes i dag';
        note.textContent = tpl.replace('[kl]', cut);
        note.style.display = '';
      } else { note.style.display = 'none'; }
    }
    var t = host.querySelector('[data-deliv-trust]'); if(t) t.textContent = range;
  }

  function render(html){
    try{
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.querySelector('#shopify-section-{{ section.id }}');
      if(fresh){ host.innerHTML = fresh.innerHTML; }
    }catch(e){ window.location.reload(); return; }
    busy = false;
    fillDelivery();
  }

  function change(key, qty){
    setBusy(true);
    fetch('{{ routes.cart_change_url }}.js', {
      method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'},
      body: JSON.stringify({ id: key, quantity: qty, sections: sectionId, sections_url: window.location.pathname })
    }).then(function(r){ return r.json(); })
      .then(function(data){ if(data.sections && data.sections[sectionId]){ render(data.sections[sectionId]); } else { window.location.reload(); } })
      .catch(function(){ window.location.reload(); });
  }

  function add(variantId){
    setBusy(true);
    fetch('{{ routes.cart_add_url }}.js', {
      method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'},
      body: JSON.stringify({ items:[{ id: Number(variantId), quantity: 1 }], sections: sectionId, sections_url: window.location.pathname })
    }).then(function(r){ return r.json(); })
      .then(function(data){ if(data.sections && data.sections[sectionId]){ render(data.sections[sectionId]); } else { window.location.reload(); } })
      .catch(function(){ window.location.reload(); });
  }

  host.addEventListener('click', function(e){
    if(busy) return;
    var step = e.target.closest('[data-step]');
    if(step){
      var item = step.closest('.item'); if(!item) return;
      var cur = parseInt(item.querySelector('.val').textContent, 10) || 1;
      var q = cur + parseInt(step.getAttribute('data-step'), 10);
      if(q < 0) q = 0;
      change(item.getAttribute('data-key'), q);
      return;
    }
    var rm = e.target.closest('[data-remove]');
    if(rm){ var it = rm.closest('.item'); if(it){ change(it.getAttribute('data-key'), 0); } return; }
    var addBtn = e.target.closest('[data-add]');
    if(addBtn){ add(addBtn.getAttribute('data-add')); return; }
    var co = e.target.closest('[data-checkout]');
    if(co){ window.location.href = '/checkout'; return; }
  });
  host.addEventListener('submit', function(e){
    var pf = e.target.closest('[data-promo]');
    if(!pf) return;
    e.preventDefault();
    var code = (pf.querySelector('input').value || '').trim();
    if(!code) return;
    window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(window.location.pathname);
  });

  fillDelivery();
})();
</script>

{% schema %}
{
  "name": "YY — Kurv-side",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Din kurv" },
    { "type": "text", "id": "subtext", "label": "Undertekst", "default": "Fri ombytning i 30 dage. Sikker betaling og hurtig levering." },
    { "type": "color", "id": "bg_color", "label": "Baggrundsfarve", "default": "#fbf9f2" },
    { "type": "range", "id": "free_ship_threshold", "min": 0, "max": 1000, "step": 25, "unit": "kr", "label": "Fri fragt over (0 = skjul bar)", "default": 400 },
    { "type": "range", "id": "ship_text_size", "min": 11, "max": 18, "step": 0.5, "unit": "px", "label": "Tekststørrelse på fragt-linjen", "default": 13, "info": "Sæt lavere hvis teksten fylder to linjer." },
    { "type": "text", "id": "ship_progress_text", "label": "Fri fragt – i gang", "default": "Køb for [beløb] mere og få fri fragt", "info": "[beløb] erstattes med det manglende beløb." },
    { "type": "text", "id": "ship_free_text", "label": "Fri fragt – opnået", "default": "Tillykke! Du har fri fragt på denne ordre 🎉" },
    { "type": "header", "content": "Tekster – varelinje" },
    { "type": "text", "id": "stock_text", "label": "Lagerstatus", "default": "På lager · klar til afsendelse" },
    { "type": "text", "id": "bundle_toggle_text", "label": "Bundle-knap", "default": "Se hvad der er inkluderet", "info": "‘(N dele)’ tilføjes automatisk." },
    { "type": "header", "content": "Levering" },
    { "type": "checkbox", "id": "show_delivery", "label": "Vis leverings-boks", "default": true },
    { "type": "range", "id": "delivery_min_days", "min": 1, "max": 10, "step": 1, "unit": "dg", "label": "Min. hverdage", "default": 1 },
    { "type": "range", "id": "delivery_max_days", "min": 1, "max": 14, "step": 1, "unit": "dg", "label": "Max. hverdage", "default": 3 },
    { "type": "range", "id": "cutoff_hour", "min": 0, "max": 23, "step": 1, "unit": "kl", "label": "Cutoff for afsendelse samme dag", "default": 12, "info": "Bestillinger inden dette klokkeslæt (hverdage) sendes samme dag." },
    { "type": "text", "id": "delivery_label", "label": "Leverings-label", "default": "Forventet levering" },
    { "type": "text", "id": "delivery_cutoff_text", "label": "Cutoff-tekst", "default": "Bestil inden kl. [kl] i dag → sendes i dag", "info": "[kl] erstattes med cutoff-timen." },
    { "type": "header", "content": "Tekster – ordreoversigt" },
    { "type": "text", "id": "summary_heading", "label": "Overskrift", "default": "Ordreoversigt" },
    { "type": "text", "id": "label_subtotal", "label": "Subtotal-label", "default": "Subtotal" },
    { "type": "text", "id": "label_shipping", "label": "Fragt-label", "default": "Fragt" },
    { "type": "text", "id": "shipping_free_text", "label": "Fragt – gratis", "default": "Gratis" },
    { "type": "text", "id": "shipping_calc_text", "label": "Fragt – beregnes", "default": "Beregnes ved kassen" },
    { "type": "text", "id": "label_total", "label": "Total-label", "default": "Total" },
    { "type": "text", "id": "savings_label", "label": "Besparelse-label", "default": "Du sparer" },
    { "type": "checkbox", "id": "show_promo", "label": "Vis rabatkode-felt", "default": true },
    { "type": "text", "id": "promo_placeholder", "label": "Rabatkode – pladsholder", "default": "Rabatkode" },
    { "type": "text", "id": "promo_button", "label": "Rabatkode – knap", "default": "Anvend" },
    { "type": "text", "id": "checkout_text", "label": "Checkout-knap", "default": "Gå til kassen" },
    { "type": "text", "id": "continue_text", "label": "Fortsæt-link", "default": "← Fortsæt med at shoppe" },
    { "type": "header", "content": "Betaling" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Vis betalingsikoner", "default": true },
    { "type": "range", "id": "pay_icon_height", "min": 14, "max": 44, "step": 1, "unit": "px", "label": "Ikon-højde", "default": 24 },
    { "type": "text", "id": "payment_icons", "label": "Tekst-fallback (kommasepareret)", "default": "VISA, MC, MOBILE PAY, APPLE PAY, VIPPS", "info": "Bruges kun hvis du ikke har tilføjet ‘Betalingsikon’-blokke med billeder nedenfor." },
    { "type": "header", "content": "Tryghed (under betaling)" },
    { "type": "checkbox", "id": "show_trust", "label": "Vis tryghedslinjer", "default": true },
    { "type": "text", "id": "trust_return", "label": "Linje 1 (ombytning)", "default": "Fri ombytning i 30 dage" },
    { "type": "text", "id": "trust_delivery", "label": "Linje 2 (levering) – prefix", "default": "Levering", "info": "Leveringsdatoen tilføjes automatisk." },
    { "type": "checkbox", "id": "show_trustpilot", "label": "Vis Trustpilot-linje", "default": true },
    { "type": "text", "id": "trust_rating", "label": "Trustpilot-tekst", "default": "4,5/5 · +45.000 anmeldelser" },
