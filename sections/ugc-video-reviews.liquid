      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video_testimonial",
      "name": "Video Review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Hosted Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback/Poster Image",
